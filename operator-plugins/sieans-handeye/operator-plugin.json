          "type": "number",
          "required": true
        },
        {
          "key": "maximumTranslationError",
          "label": "标定板最大平移误差",
          "type": "number",
          "required": true
        },
        {
          "key": "maximumAngleErrorDegrees",
          "label": "标定板最大旋转误差 (°)",
          "type": "number",
          "required": true
        },
        {
          "key": "unit",
          "label": "平移误差单位",
          "type": "string",
          "required": true
        },
        {
          "key": "items",
          "label": "各姿态一致性明细",
          "type": "array",
          "required": true
        },
        {
          "key": "note",
          "label": "适用条件说明",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "id": "check",
      "name": "手眼标定 · 独立姿态验证",
      "input": "none",
      "entry": "handeye.py",
      "timeoutMs": 30000,
      "description": "用未参与拟合的三组以上同步姿态，对比原标定板基座位姿，不重新拟合。约定/单位沿用参考记录；移动标定板后应重新建立标定，不能直接沿用该验证参考。",
      "parameters": [
        {
          "key": "task",
          "label": "算子功能",
          "type": "string",
          "default": "check",
          "required": true,
          "choices": [
            {
              "value": "check",
              "label": "手眼标定 · 独立姿态验证"
            }
          ]
        },
