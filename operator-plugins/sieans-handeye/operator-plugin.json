            {
              "key": "robotRz",
              "label": "工具→基座 Rz",
              "type": "number",
              "default": 0,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "key": "cameraX",
              "label": "标定板→相机 X",
              "type": "number",
              "default": 0,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "key": "cameraY",
              "label": "标定板→相机 Y",
              "type": "number",
              "default": 0,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "key": "cameraZ",
              "label": "标定板→相机 Z",
              "type": "number",
              "default": 1,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "key": "cameraRx",
              "label": "标定板→相机 Rx (rad)",
              "type": "number",
