          "type": "string",
          "default": "rodrigues-rad",
          "required": true,
          "choices": [
            {
              "value": "rodrigues-rad",
              "label": "Rodrigues 轴角向量 · 弧度"
            },
            {
              "value": "euler-zyx-deg",
              "label": "固定轴 Rz(z) × Ry(y) × Rx(x) · 度"
            }
          ]
        },
        {
          "key": "method",
          "label": "手眼求解方法",
          "type": "string",
          "default": "park",
          "required": true,
          "choices": [
            {
              "value": "park",
              "label": "Park · 旋转对齐与平移最小二乘"
            }
          ]
        },
        {
          "key": "poses",
          "label": "同步采样姿态表",
          "type": "array",
          "default": [],
          "required": true,
          "columns": [
            {
              "key": "robotX",
              "label": "工具→基座 X",
              "type": "number",
              "default": 0,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "key": "robotY",
              "label": "工具→基座 Y",
              "type": "number",
              "default": 0,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "key": "robotZ",
              "label": "工具→基座 Z",
              "type": "number",
              "default": 0,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "key": "robotRx",
              "label": "工具→基座 Rx",
              "type": "number",
              "default": 0,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            {
              "key": "robotRy",
              "label": "工具→基座 Ry",
              "type": "number",
              "default": 0,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
