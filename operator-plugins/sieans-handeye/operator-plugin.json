{
  "apiVersion": 1,
  "id": "sieans-handeye",
  "name": "SIEANS 眼在手上标定",
  "version": "1.0.0",
  "license": "MIT",
  "description": "棋盘位姿、同步多姿态手眼标定与独立姿态验证。",
  "operators": [
    {
      "id": "pose",
      "name": "棋盘格位姿 · 标定板到相机",
      "input": "image",
      "entry": "handeye.py",
      "timeoutMs": 30000,
      "description": "使用已有内参，IPPE 求平面位姿并检查正深度、重投影及双解歧义。rvec 为弧度轴角。普通棋盘无唯一标记，跨采样须人工核对同一原点/轴向；不自动保证角点编号一致。",
      "parameters": [
        {
          "key": "task",
          "label": "算子功能",
          "type": "string",
          "default": "pose",
          "required": true,
          "choices": [
            {
              "value": "pose",
              "label": "棋盘格位姿 · 标定板到相机"
            }
          ]
        },
        {
          "key": "intrinsics",
          "label": "针孔相机内参标定结果",
          "type": "object",
          "default": {},
          "required": true
        },
        {
          "key": "columns",
          "label": "棋盘内角点列数",
          "type": "integer",
          "default": 9,
          "required": true,
          "minimum": 3,
          "maximum": 15
        },
        {
          "key": "rows",
          "label": "棋盘内角点行数",
          "type": "integer",
          "default": 6,
          "required": true,
          "minimum": 3,
          "maximum": 15
        },
        {
          "key": "squareSize",
          "label": "实际格边长",
          "type": "number",
          "default": 20,
          "required": true,
          "minimum": 0.001,
          "maximum": 10000
        },
        {
          "key": "unit",
          "label": "格边长单位",
          "type": "string",
          "default": "mm",
          "required": true,
          "choices": [
            {
              "value": "mm",
              "label": "毫米 mm"
            },
            {
              "value": "m",
              "label": "米 m"
            }
          ]
        },
        {
          "key": "reverseCorners",
          "label": "反转角点顺序以核对同一原点",
          "type": "boolean",
          "default": false,
          "required": true
        },
        {
          "key": "maximumReprojectionError",
          "label": "最大重投影误差 (px)",
          "type": "number",
          "default": 1,
          "required": true,
          "minimum": 0.001,
          "maximum": 100
        },
        {
          "key": "minimumAmbiguityGap",
          "label": "候选位姿最小误差差距 (px)",
          "type": "number",
          "default": 0.05,
          "required": true,
          "minimum": 0,
          "maximum": 10
        }
      ],
      "outputs": [
        {
          "key": "pose",
          "label": "标定板→相机的平移/旋转向量",
          "type": "object",
          "required": true
        },
        {
          "key": "unit",
          "label": "平移长度单位",
          "type": "string",
          "required": true
        },
        {
          "key": "rotationConvention",
          "label": "旋转向量约定",
          "type": "string",
          "required": true
        },
        {
          "key": "rmsPixels",
          "label": "重投影 RMS (px)",
          "type": "number",
          "required": true
        },
        {
          "key": "cornerCount",
          "label": "内角点数",
          "type": "integer",
          "required": true
        },
        {
          "key": "originX",
          "label": "选定原点图像 X (px)",
          "type": "number",
          "required": true
        },
        {
          "key": "originY",
          "label": "选定原点图像 Y (px)",
          "type": "number",
          "required": true
        },
        {
          "key": "note",
          "label": "坐标及原点说明",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "id": "fit",
      "name": "眼在手上 · 多姿态手眼标定",
      "input": "none",
      "entry": "handeye.py",
      "timeoutMs": 30000,
      "description": "相机固定在工具上、标定板固定在基座。表格必须为工具→基座及标定板→相机，且对应同一停止姿态。至少六组，建议十组以上绕不同轴旋转。旋转向量不是欧拉角；模型可传给 3D 坐标转换。",
      "parameters": [
        {
          "key": "task",
          "label": "算子功能",
          "type": "string",
          "default": "fit",
          "required": true,
          "choices": [
            {
              "value": "fit",
              "label": "眼在手上 · 多姿态手眼标定"
            }
          ]
        },
        {
          "key": "cameraFrame",
          "label": "相机光学坐标系",
          "type": "string",
          "default": "camera-optical",
          "required": true
        },
        {
          "key": "toolFrame",
          "label": "机器人工具坐标系",
          "type": "string",
          "default": "tool0",
          "required": true
        },
        {
          "key": "baseFrame",
          "label": "机器人基座坐标系",
          "type": "string",
          "default": "robot-base",
          "required": true
        },
        {
          "key": "boardFrame",
          "label": "固定标定板坐标系",
          "type": "string",
          "default": "calibration-board",
          "required": true
        },
        {
          "key": "robotUnit",
          "label": "机器人平移单位",
          "type": "string",
          "default": "mm",
          "required": true,
          "choices": [
            {
              "value": "mm",
              "label": "毫米 mm"
            },
            {
              "value": "m",
              "label": "米 m"
            }
          ]
        },
        {
          "key": "cameraUnit",
          "label": "标定板位姿平移单位",
          "type": "string",
          "default": "mm",
          "required": true,
          "choices": [
            {
              "value": "mm",
              "label": "毫米 mm"
            },
            {
              "value": "m",
              "label": "米 m"
            }
          ]
        },
        {
          "key": "robotRotation",
