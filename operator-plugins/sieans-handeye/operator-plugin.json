              "default": 0,
              "required": true,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            }
          ],
          "minimumRows": 0,
          "maximumRows": 100
        },
        {
          "key": "maximumTranslationRms",
          "label": "最大平移 RMS (mm)",
          "type": "number",
          "default": 1,
          "required": true,
          "minimum": 0,
          "maximum": 1000000000.0
        },
        {
          "key": "maximumTranslationError",
          "label": "最大单次平移误差 (mm)",
          "type": "number",
          "default": 2,
          "required": true,
          "minimum": 0,
