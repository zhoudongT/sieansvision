        {
          "key": "rejectedCount",
          "label": "排除对应点数",
          "type": "integer",
          "required": true
        },
        {
          "key": "rmsError",
          "label": "拟合内点均方根误差",
          "type": "number",
          "required": true
        },
        {
          "key": "maximumError",
          "label": "拟合内点最大误差",
