          "key": "pairs",
          "label": "输入/目标对应点表",
          "type": "array",
          "default": [
            {
              "sourceX": 0.0,
              "sourceY": 0.0,
              "sourceZ": 0.0,
              "targetX": 300.0,
              "targetY": 500.0,
              "targetZ": 100.0
            },
            {
              "sourceX": 100.0,
              "sourceY": 0.0,
