        {
          "key": "method",
          "label": "拟合方式",
          "type": "string",
          "default": "all",
          "required": true,
          "choices": [
            {
              "value": "all",
              "label": "全部对应点最小二乘"
            },
            {
              "value": "ransac",
              "label": "RANSAC 排除错误对应"
            }
          ]
        },
        {
          "key": "inlierThreshold",
          "label": "内点距离阈值（目标单位）",
          "type": "number",
          "default": 1,
          "required": true,
          "minimum": 1e-09,
          "maximum": 1000000000.0
        },
        {
          "key": "minimumInlierRatio",
          "label": "最低内点比例",
          "type": "number",
          "default": 0.8,
          "required": true,
          "minimum": 0.1,
          "maximum": 1
        },
        {
          "key": "iterations",
          "label": "RANSAC 抽样次数",
          "type": "integer",
          "default": 300,
          "required": true,
          "minimum": 10,
          "maximum": 2000
