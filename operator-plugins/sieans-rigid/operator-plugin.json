{
  "apiVersion": 1,
  "id": "sieans-rigid",
  "name": "SIEANS 三维坐标标定与转换",
  "version": "1.0.0",
  "license": "MIT",
  "description": "对应点刚体标定、独立验证、正反向点位/点云坐标转换。",
  "operators": [
    {
      "id": "calibrate",
      "name": "3D 对应点刚体标定",
      "input": "none",
      "entry": "rigid.py",
      "timeoutMs": 15000,
      "description": "默认点表为合成演示，生产须替换。按行对应同一物理点。至少三个不共线点，建议六个以上并覆盖三维空间。估计旋转/平移；长度单位明确换算，不估计未知缩放。此方法不是运动式手眼标定。",
      "parameters": [
        {
          "key": "task",
          "label": "算子功能",
          "type": "string",
          "default": "calibrate",
          "required": true,
          "choices": [
            {
              "value": "calibrate",
              "label": "3D 对应点刚体标定"
            }
          ]
        },
        {
          "key": "sourceFrame",
          "label": "输入坐标系名称",
          "type": "string",
          "default": "camera-optical",
          "required": true
        },
        {
          "key": "targetFrame",
          "label": "目标坐标系名称",
          "type": "string",
          "default": "fixture-base",
          "required": true
        },
        {
          "key": "sourceUnit",
          "label": "输入点长度单位",
          "type": "string",
          "default": "mm",
          "required": true,
          "choices": [
            {
              "value": "mm",
              "label": "毫米 mm"
            },
            {
              "value": "m",
              "label": "米 m"
            }
          ]
        },
        {
          "key": "targetUnit",
          "label": "目标点长度单位",
          "type": "string",
          "default": "mm",
          "required": true,
          "choices": [
            {
              "value": "mm",
              "label": "毫米 mm"
            },
            {
              "value": "m",
              "label": "米 m"
            }
          ]
        },
