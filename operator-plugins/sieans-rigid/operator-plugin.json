        {
          "key": "seed",
          "label": "RANSAC 随机种子",
          "type": "integer",
          "default": 0,
          "required": true,
          "minimum": 0,
          "maximum": 2147483647
        },
        {
          "key": "maximumRms",
          "label": "最大均方根误差（目标单位）",
          "type": "number",
          "default": 0.2,
          "required": true,
          "minimum": 0,
          "maximum": 1000000000.0
