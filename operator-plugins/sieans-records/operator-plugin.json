{
  "apiVersion": 1,
  "id": "sieans-records",
  "name": "SIEANS 流程记录处理",
  "version": "1.0.0",
  "license": "MIT",
  "description": "有界记录创建、采样累积、查询筛选、排序、映射与统计。",
  "operators": [
    {
      "id": "build",
      "name": "按字段创建记录",
      "description": "在字段表中定义名称、类型和变量/上游结果绑定，输出单条结构体。可以整理检测值或机器人与相机位姿，不运行自定义脚本。",
      "entry": "records.py",
      "input": "none",
      "timeoutMs": 5000,
      "parameters": [
        {
          "key": "task",
          "label": "处理功能",
          "type": "string",
          "default": "build",
          "required": true,
          "choices": [
            {
              "value": "build",
              "label": "按字段创建记录"
            }
          ]
        },
        {
          "key": "fields",
          "label": "记录字段与绑定",
          "type": "object",
          "default": {
            "value": 0
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "record",
          "label": "单条记录",
          "type": "object",
          "required": true
        },
        {
          "key": "fieldCount",
          "label": "字段数",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "id": "append",
      "name": "记录表追加与去重",
      "description": "输入/输出记录表可绑定同一个变量，流程成功后提交。默认满表和重复键报错，不静默覆盖。最多 1000 行/500 KB，新记录最多 50 KB；键区分数值、文本和开关。",
      "entry": "records.py",
      "input": "none",
      "timeoutMs": 5000,
      "parameters": [
        {
          "key": "task",
          "label": "处理功能",
          "type": "string",
          "default": "append",
          "required": true,
          "choices": [
            {
              "value": "append",
              "label": "记录表追加与去重"
            }
          ]
        },
        {
          "key": "records",
          "label": "输入记录表",
          "type": "array",
          "default": [],
          "required": true
        },
        {
          "key": "record",
          "label": "待追加记录",
          "type": "object",
          "default": {},
          "required": true
        },
        {
          "key": "capacity",
          "label": "最大保留行数",
          "type": "integer",
          "default": 100,
          "required": true,
          "minimum": 1,
          "maximum": 1000
        },
        {
          "key": "overflow",
          "label": "满表策略",
          "type": "string",
          "default": "error",
          "required": true,
          "choices": [
            {
              "value": "error",
              "label": "报错并保留原表"
            },
            {
              "value": "drop-oldest",
              "label": "丢弃最早一行"
            }
          ]
        },
        {
          "key": "keyField",
          "label": "去重键路径（空白关闭去重）",
          "type": "string",
          "default": "",
          "required": false
        },
        {
          "key": "duplicate",
          "label": "键重复策略",
          "type": "string",
          "default": "error",
          "required": true,
          "choices": [
            {
              "value": "error",
              "label": "报错"
            },
            {
              "value": "ignore",
              "label": "忽略新记录"
            },
            {
              "value": "replace",
              "label": "原位替换"
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "records",
          "label": "输出记录表",
          "type": "array",
          "required": true
        },
        {
          "key": "count",
          "label": "输出记录数",
          "type": "integer",
          "required": true
        },
        {
          "key": "accepted",
          "label": "接收新记录",
          "type": "boolean",
          "required": true
        },
        {
          "key": "replaced",
          "label": "替换已有行",
          "type": "boolean",
          "required": true
        },
        {
          "key": "discarded",
          "label": "因满表丢弃行数",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "id": "filter",
      "name": "记录筛选与排除",
      "description": "严格按类型筛选，不把文本数字或开关隐式转成数值。字段存在/缺失比较区分空值与缺失；跳过缺字段时，该行不会进入保留或排除结果。",
      "entry": "records.py",
      "input": "none",
      "timeoutMs": 5000,
      "parameters": [
        {
          "key": "task",
          "label": "处理功能",
          "type": "string",
          "default": "filter",
          "required": true,
          "choices": [
            {
              "value": "filter",
              "label": "记录筛选与排除"
            }
          ]
        },
        {
          "key": "records",
          "label": "输入记录表",
          "type": "array",
          "default": [],
          "required": true
        },
        {
          "key": "field",
          "label": "字段路径（点分隔）",
          "type": "string",
          "default": "value",
          "required": true
        },
        {
          "key": "comparison",
          "label": "比较方式",
          "type": "string",
          "default": "eq",
          "required": true,
          "choices": [
            {
              "value": "eq",
              "label": "等于"
            },
            {
              "value": "ne",
              "label": "不等于"
            },
            {
              "value": "gt",
              "label": "大于"
            },
            {
              "value": "gte",
              "label": "大于等于"
            },
            {
              "value": "lt",
              "label": "小于"
            },
            {
              "value": "lte",
              "label": "小于等于"
            },
            {
              "value": "contains",
              "label": "文本包含"
            },
            {
              "value": "is_true",
              "label": "开关为是"
            },
            {
              "value": "is_false",
              "label": "开关为否"
            },
            {
              "value": "exists",
              "label": "字段存在"
            },
            {
              "value": "missing",
              "label": "字段缺失"
            }
          ]
        },
        {
          "key": "operand",
          "label": "比较值（value 字段）",
          "type": "object",
          "default": {
            "value": 0
          },
          "required": true
        },
        {
          "key": "keepMatches",
          "label": "保留匹配行（否则排除）",
          "type": "boolean",
          "default": true,
          "required": true
        },
        {
          "key": "missing",
          "label": "缺失字段处理",
          "type": "string",
          "default": "error",
          "required": true,
          "choices": [
            {
              "value": "error",
              "label": "报错"
            },
            {
              "value": "skip",
              "label": "跳过该行"
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "records",
          "label": "输出记录表",
          "type": "array",
          "required": true
        },
        {
          "key": "count",
          "label": "输出记录数",
          "type": "integer",
          "required": true
        },
        {
          "key": "inputCount",
          "label": "输入记录数",
          "type": "integer",
          "required": true
        },
        {
          "key": "matchedCount",
          "label": "符合条件行数",
          "type": "integer",
          "required": true
        },
        {
          "key": "missingCount",
          "label": "缺字段行数",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "id": "sort",
      "name": "记录字段稳定排序",
      "description": "按同类型数值、文本或开关排序。同值保留原相对顺序；不混排文本和数值。缺失/空值的位置不受升降序影响。",
      "entry": "records.py",
      "input": "none",
      "timeoutMs": 5000,
      "parameters": [
        {
          "key": "task",
          "label": "处理功能",
          "type": "string",
          "default": "sort",
          "required": true,
          "choices": [
            {
              "value": "sort",
              "label": "记录字段稳定排序"
            }
          ]
        },
        {
          "key": "records",
          "label": "输入记录表",
          "type": "array",
          "default": [],
          "required": true
        },
        {
          "key": "field",
          "label": "字段路径（点分隔）",
          "type": "string",
          "default": "value",
          "required": true
        },
        {
          "key": "direction",
          "label": "排序方向",
          "type": "string",
          "default": "ascending",
          "required": true,
          "choices": [
            {
              "value": "ascending",
              "label": "升序"
            },
            {
              "value": "descending",
              "label": "降序"
            }
          ]
        },
        {
          "key": "missing",
          "label": "缺失或空值处理",
          "type": "string",
          "default": "error",
          "required": true,
          "choices": [
            {
              "value": "error",
              "label": "报错"
            },
            {
              "value": "first",
              "label": "放在最前"
            },
            {
              "value": "last",
              "label": "放在最后"
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "records",
          "label": "输出记录表",
          "type": "array",
          "required": true
        },
        {
          "key": "count",
          "label": "输出记录数",
          "type": "integer",
          "required": true
        },
        {
          "key": "missingCount",
          "label": "缺失或空值行数",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "id": "select",
      "name": "按行读取记录",
      "description": "索引可绑定变量或循环轮次。越界返回空记录时必须检查 found，不把缺失行当作有效测量。",
      "entry": "records.py",
      "input": "none",
      "timeoutMs": 5000,
      "parameters": [
        {
          "key": "task",
          "label": "处理功能",
          "type": "string",
          "default": "select",
          "required": true,
          "choices": [
            {
              "value": "select",
              "label": "按行读取记录"
            }
          ]
        },
        {
          "key": "records",
          "label": "输入记录表",
          "type": "array",
          "default": [],
          "required": true
        },
        {
          "key": "index",
          "label": "行索引（0 起，-1 末行）",
          "type": "integer",
          "default": 0,
          "required": true,
          "minimum": -1,
          "maximum": 999
        },
        {
          "key": "outOfRange",
          "label": "越界处理",
          "type": "string",
          "default": "error",
          "required": true,
          "choices": [
            {
              "value": "error",
              "label": "报错"
            },
            {
              "value": "empty",
              "label": "返回未找到与空记录"
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "found",
          "label": "找到记录",
          "type": "boolean",
          "required": true
        },
        {
          "key": "record",
          "label": "所选记录",
          "type": "object",
          "required": true
        },
        {
          "key": "index",
          "label": "实际行索引",
          "type": "integer",
          "required": true
        },
        {
          "key": "count",
          "label": "输入记录数",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "id": "project",
      "name": "记录字段映射与精简",
      "description": "只保留映射的字段，可改名、展开嵌套字段或提取数组项。适合把含采样编号的记录整理成标定算子要求的精确列集。",
      "entry": "records.py",
      "input": "none",
      "timeoutMs": 5000,
      "parameters": [
        {
          "key": "task",
          "label": "处理功能",
          "type": "string",
          "default": "project",
          "required": true,
          "choices": [
            {
              "value": "project",
              "label": "记录字段映射与精简"
            }
          ]
        },
        {
          "key": "records",
          "label": "输入记录表",
          "type": "array",
          "default": [],
          "required": true
        },
        {
          "key": "columns",
          "label": "输出字段与来源路径表",
          "type": "array",
          "default": [
            {
              "output": "value",
              "source": "value"
            }
          ],
          "required": true,
          "columns": [
            {
              "key": "output",
              "label": "输出字段名",
              "type": "string",
              "default": "value",
              "required": true
            },
            {
              "key": "source",
              "label": "来源字段路径",
              "type": "string",
              "default": "value",
              "required": true
            }
          ],
          "minimumRows": 1,
          "maximumRows": 100
        },
        {
          "key": "missing",
          "label": "来源缺失处理",
          "type": "string",
          "default": "error",
          "required": true,
          "choices": [
            {
              "value": "error",
              "label": "报错"
            },
            {
              "value": "skip-row",
              "label": "跳过整行"
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "records",
          "label": "输出记录表",
          "type": "array",
          "required": true
        },
        {
          "key": "count",
          "label": "输出记录数",
          "type": "integer",
          "required": true
        },
        {
          "key": "inputCount",
          "label": "输入记录数",
          "type": "integer",
          "required": true
        },
        {
          "key": "skippedCount",
          "label": "跳过行数",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "id": "summary",
      "name": "记录数值字段统计",
      "description": "计算和、均值、最小/最大、中位数及总体标准差。只接受数值；空值按缺失策略处理。没有有效值时返回空统计表和 hasValues=false，不填充假的测量值。",
      "entry": "records.py",
      "input": "none",
      "timeoutMs": 5000,
      "parameters": [
        {
          "key": "task",
          "label": "处理功能",
          "type": "string",
          "default": "summary",
          "required": true,
          "choices": [
            {
              "value": "summary",
              "label": "记录数值字段统计"
            }
          ]
        },
        {
          "key": "records",
          "label": "输入记录表",
          "type": "array",
          "default": [],
          "required": true
        },
        {
          "key": "field",
          "label": "字段路径（点分隔）",
          "type": "string",
          "default": "value",
          "required": true
        },
        {
          "key": "missing",
          "label": "缺失字段处理",
          "type": "string",
          "default": "error",
          "required": true,
          "choices": [
            {
              "value": "error",
              "label": "报错"
            },
            {
              "value": "skip",
              "label": "跳过该行"
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "inputCount",
          "label": "输入记录数",
          "type": "integer",
          "required": true
        },
        {
          "key": "valueCount",
          "label": "有效数值数",
          "type": "integer",
          "required": true
        },
        {
          "key": "missingCount",
          "label": "缺失或空值数",
          "type": "integer",
          "required": true
        },
        {
          "key": "hasValues",
          "label": "存在有效数值",
          "type": "boolean",
          "required": true
        },
        {
          "key": "summary",
          "label": "数值统计表",
          "type": "object",
          "required": true
        }
      ]
    }
  ]
}
