{
  "version": 2,
  "id": "7f3cef81add4428f",
  "name": "打开即跑 · 几何查找→多匹配密度",
  "steps": [
    {
      "id": "afa68ba4fc51478c",
      "operation": "preprocess",
      "name": "预处理·灰度",
      "params": {
        "method": "grayscale",
        "kernel": 3,
        "threshold": 128,
        "cannyLow": 50,
        "cannyHigh": 150,
        "invert": false,
        "roiMode": "inherit",
        "showRoiOverlay": false
      },
      "position": {
        "x": 300,
        "y": 140
      },
      "imageFrom": "source"
    },
    {
      "id": "c77873e5518f4fca",
      "operation": "geometry",
      "name": "直线查找·Hough",
      "params": {
        "feature": "lines",
        "findMethod": "hough",
        "roiPreset": "full",
        "edgeType": "strongest",
        "edgePolarity": "any",
        "edgeThreshold": 40,
        "maxCount": 4,
        "minScore": 0.35,
        "minLength": 40,
        "showOverlay": true,
        "showPoints": true,
        "showFitCurve": true,
        "showLabels": true,
        "judgeEnable": true,
        "judgeMetric": "count",
        "judgeMin": 1,
        "judgeMax": 8,
        "resultVar": "geom"
      },
      "position": {
        "x": 300,
        "y": 260
      },
      "imageFrom": "afa68ba4fc51478c"
    },
    {
      "id": "f05d273cfeda4daa",
      "operation": "locate",
      "name": "多模板匹配·密度",
      "params": {
        "matchMode": "fast",
        "minScore": 0.55,
        "maxMatches": 5,
        "angleStart": -30,
        "angleEnd": 30,
        "angleStep": 30,
        "scales": [
          0.8,
          1,
          1.2
        ],
        "scaleStart": 0.8,
        "scaleEnd": 1.2,
        "scaleStep": 0.2,
        "overlapThreshold": 0.3,
        "maxOverlap": 0.3,
        "hasTemplate": true,
        "templateReady": true,
        "showMatchBox": true,
        "showScore": true,
        "showContour": true,
        "fullSearch": false,
        "matchPolarity": "consider"
      },
      "reference": "data:image/png;base64,",
      "position": {
        "x": 300,
        "y": 380
      },
      "imageFrom": "c77873e5518f4fca"
    },
    {
      "id": "8fe1a98da31a4126",
      "operation": "var_calc",
      "name": "查找门限·OK/NG",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "lineCount",
            "expression": "geometry_count"
          },
          {
            "name": "matchCount",
            "expression": "locate_count"
          },
          {
            "name": "matchScore",
            "expression": "locate_score"
          },
          {
            "name": "passGate",
            "expression": "(geometry_count >= 1) and (locate_score >= 0.55)"
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 500
      },
      "imageFrom": "f05d273cfeda4daa"
    }
  ],
  "edges": [
    {
      "id": "80903af709df4005",
      "from": "source",
      "to": "afa68ba4fc51478c",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "4f3498af4cdc4709",
      "from": "afa68ba4fc51478c",
      "to": "c77873e5518f4fca",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "7f48eea197744319",
      "from": "c77873e5518f4fca",
      "to": "f05d273cfeda4daa",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "4025212ccff14b44",
      "from": "f05d273cfeda4daa",
      "to": "8fe1a98da31a4126",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ],
  "sourcePosition": {
    "x": 300,
    "y": 40
  },
  "variables": {
    "flow": {}
  },
  "sourceConfig": {
    "mode": "local",
    "pixelFormat": "RGB24",
    "intervalMs": 0,
    "saveInSolution": false,
    "showImageName": true,
    "snStart": 0,
    "imageCache": 0,
    "outputMono8": false,
    "stitchEnable": false,
    "stitchStartY": 0,
    "stitchHeight": 0,
    "stitchClearOnTrigger": false,
    "autoSwitch": false,
    "stopAtLast": true,
    "charFilterEnable": false,
    "inputChar": "",
    "triggerChar": "",
    "cameraId": "",
    "cameraParams": {},
    "exposure": 0,
    "gain": 0,
    "images": [
      "/home/allen/文档/sieansvision/public/vision/samples/caliper-line.png",
      "/home/allen/文档/sieansvision/public/vision/samples/circle-ring.png",
      "/home/allen/文档/sieansvision/public/vision/samples/fixture-multiple.png"
    ],
    "currentIndex": 0
  },
  "runUi": {
    "split": "4",
    "placements": [
      {
        "name": "图像",
        "page": 3,
        "cell": 0,
        "category": "基础"
      },
      {
        "name": "OK/NG",
        "page": 3,
        "cell": 1,
        "category": "基础"
      },
      {
        "name": "运行控制",
        "page": 3,
        "cell": 2,
        "category": "基础"
      },
      {
        "name": "生产统计",
        "page": 3,
        "cell": 3,
        "category": "图表"
      }
    ],
    "controls": {
      "图像": {
        "commands": [],
        "binding": ""
      },
      "OK/NG": {
        "commands": [],
        "binding": "passGate"
      },
      "运行控制": {
        "commands": [
          {
            "type": "执行·单次"
          },
          {
            "type": "执行·停止"
          }
        ],
        "binding": ""
      },
      "生产统计": {
        "commands": [],
        "binding": "passGate"
      }
    },
    "fixedBars": {
      "bottom": true,
      "gateKey": "passGate",
      "showCounters": true
    },
    "meta": {
      "title": "几何查找+匹配密度 · 打开即跑",
      "industry": "locate"
    }
  },
  "notes": "wave140：几何查找（Hough 直线，非卡尺测量链）胶片铬 L/C/R/B + 模板匹配多命中密度表（分数/坐标/判定）。▶ 单次：预处理→直线查找→多匹配→门限。无 Halcon / 无机器人 SDK / 无现场硬件。"
}
