{
  "version": 2,
  "id": "3f4384ea4de44b6f",
  "name": "打开即跑 · 卡尺→测量链判定",
  "steps": [
    {
      "id": "88437751b6394bfd",
      "operation": "preprocess",
      "name": "图像预处理",
      "params": {
        "method": "grayscale",
        "threshold": 127,
        "kernel": 3,
        "cannyLow": 50,
        "cannyHigh": 150,
        "invert": false,
        "blur": 1
      },
      "position": {
        "x": 300,
        "y": 140
      },
      "imageFrom": "source"
    },
    {
      "id": "a511881928374398",
      "operation": "geometry",
      "name": "卡尺直线查找",
      "params": {
        "feature": "lines",
        "findMethod": "caliper",
        "roiPreset": "center",
        "caliperCount": 16,
        "caliperWidth": 18,
        "caliperLength": 220,
        "caliperSigma": 1.0,
        "caliperProjAngle": 0.0,
        "edgeType": "all",
        "edgePolarity": "any",
        "edgeThreshold": 25,
        "searchDir": "left_right",
        "maxCount": 3,
        "minScore": 0.35,
        "minLength": 40,
        "maximumResidual": 3.0,
        "rejectPoints": 1,
        "showOverlay": true,
        "showPoints": true,
        "showCalipers": true,
        "showFitCurve": true,
        "showFitError": true,
        "showLabels": true,
        "showRuler": true,
        "subPixel": true,
        "filterSize": 1
      },
      "position": {
        "x": 300,
        "y": 280
      },
      "imageFrom": "88437751b6394bfd"
    },
    {
      "id": "f28467b7a8134cde",
      "operation": "line_intersect",
      "name": "两直线交点·判OK",
      "params": {
        "mode": "bind",
        "line1From": "a511881928374398",
        "line1Field": "lines[0]",
        "line2From": "a511881928374398",
        "line2Field": "lines[1]",
        "unit": "px",
        "scale": 1.0,
        "showOverlay": true,
        "showPoints": true,
        "showLines": true,
        "showLabels": true,
        "showDistanceText": true,
        "x1": 0,
        "y1": 0,
        "x2": 100,
        "y2": 0,
        "x3": 50,
        "y3": -50,
        "x4": 50,
        "y4": 50,
        "resultVar": "ixPt",
        "writeFlowVars": true,
        "judgeEnable": true,
        "judgeMin": 0.0,
        "judgeMax": 99999.0
      },
      "position": {
        "x": 300,
        "y": 340
      },
      "imageFrom": "a511881928374398"
    },
    {
      "id": "970477979fba492f",
      "operation": "point_line_distance",
      "name": "交点到线3垂距·判OK",
      "params": {
        "mode": "bind",
        "pointFrom": "f28467b7a8134cde",
        "pointField": "",
        "lineFrom": "a511881928374398",
        "lineField": "lines[2]",
        "unit": "px",
        "scale": 1.0,
        "showOverlay": true,
        "showPoints": true,
        "showLines": true,
        "showLabels": true,
        "showDistanceText": true,
        "px": 0,
        "py": 0,
        "x1": 0,
        "y1": 0,
        "x2": 100,
        "y2": 0,
        "resultVar": "pldDist",
        "writeFlowVars": true,
        "judgeEnable": true,
        "judgeMin": 0.5,
        "judgeMax": 800.0
      },
      "position": {
        "x": 300,
        "y": 440
      },
      "imageFrom": "f28467b7a8134cde"
    },
    {
      "id": "153f422383c34c88",
      "operation": "var_calc",
      "name": "测量链门限·OK/NG",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "lineCount",
            "expression": "geometry_count",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "lineScore",
            "expression": "geometry_score",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "intersectX",
            "expression": "ixPt_x",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "intersectY",
            "expression": "ixPt_y",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "ixJudge",
            "expression": "ixPt_judgeOk",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "pld",
            "expression": "pldDist_distance",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "pldJudge",
            "expression": "pldDist_judgeOk",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "passGate",
            "expression": "lineCount >= 2 && ixJudge == 1 && pldJudge == 1",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 540
      },
      "imageFrom": "970477979fba492f"
    }
  ],
