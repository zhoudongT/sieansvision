{
  "version": 2,
  "id": "b0402d3683964ef8",
  "name": "默认产线 · 上位机运行壳",
  "steps": [
    {
      "id": "2c4d5e1937b74ee8",
      "operation": "preprocess",
      "name": "图像预处理",
      "params": {
        "method": "grayscale",
        "threshold": 127,
        "kernel": 3,
        "cannyLow": 50,
        "cannyHigh": 150,
        "invert": false,
        "blur": 1
      },
      "position": {
        "x": 300,
        "y": 140
      },
      "imageFrom": "source"
    },
    {
      "id": "b196bbc0953b4acd",
      "operation": "geometry",
      "name": "圆查找",
      "params": {
        "feature": "circles",
        "minRadius": 20,
        "maxRadius": 180,
        "minDistance": 30,
        "votes": 25,
        "cannyLow": 50,
        "cannyHigh": 150,
        "maxCount": 5,
        "filterSize": 1,
        "threshold": 127,
        "minArea": 50,
        "edgeType": "strongest",
        "edgePolarity": "any",
        "edgeThreshold": 30,
        "caliperCount": 20,
        "showOverlay": true,
        "showPoints": true,
        "annulusInner": 0,
        "annulusOuter": 0
      },
      "position": {
        "x": 300,
        "y": 240
      },
      "imageFrom": "2c4d5e1937b74ee8"
    },
    {
      "id": "ba15d7260971408a",
      "operation": "measure",
      "name": "尺寸测量",
      "params": {
        "feature": "circles",
        "threshold": 127,
        "minArea": 50,
        "unit": "px"
      },
      "position": {
        "x": 300,
        "y": 340
      },
      "imageFrom": "b196bbc0953b4acd"
    },
    {
      "id": "f8c62d9c8b2a4d58",
      "operation": "var_calc",
      "name": "结果变量",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "circleCount",
            "expression": "geometry_count",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "firstRadius",
            "expression": "geometry_radius",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "passGate",
            "expression": "circleCount > 0",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 440
      }
    }
  ],
  "edges": [
    {
      "id": "632a7286e6ca4253",
      "from": "source",
      "to": "2c4d5e1937b74ee8",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6b85fb878ef46cc",
      "from": "2c4d5e1937b74ee8",
      "to": "b196bbc0953b4acd",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "07f74eaee4e74605",
      "from": "b196bbc0953b4acd",
      "to": "ba15d7260971408a",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "3cacd2df5f8d4a29",
      "from": "ba15d7260971408a",
      "to": "f8c62d9c8b2a4d58",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ],
  "sourcePosition": {
    "x": 300,
    "y": 40
  },
  "variables": {
    "heartbeatTick": "HB",
    "heartbeatAt": "0"
  },
  "sourceConfig": {
    "mode": "local",
    "pixelFormat": "RGB24",
    "intervalMs": 200,
    "saveInSolution": false,
    "showImageName": true,
    "snStart": 0,
    "imageCache": 0,
    "outputMono8": false,
    "stitchEnable": false,
    "stitchStartY": 0,
    "stitchHeight": 0,
    "stitchClearOnTrigger": false,
    "autoSwitch": false,
    "stopAtLast": true,
    "charFilterEnable": false,
    "inputChar": "",
    "triggerChar": "",
    "cameraId": "",
    "cameraParams": {},
    "exposure": 0.0,
    "gain": 0.0,
    "images": [
      "public/vision/samples/circle-ring.png",
      "public/vision/samples/circle-hole.png",
      "public/vision/samples/caliper-line.png",
      "public/vision/samples/fixture-multiple.png"
    ],
    "currentIndex": 0
  },
  "runUi": {
    "split": "2",
    "placements": [
      {
        "name": "图像",
        "page": 1,
        "cell": 0,
        "category": "基础"
      },
      {
        "name": "上位机状态机",
        "page": 1,
        "cell": 1,
        "category": "基础"
      }
    ],
    "controls": {
      "图像": {
        "commands": [],
        "binding": "source"
      },
      "上位机状态机": {
        "commands": [
          {
            "type": "执行·连续",
            "config": "正常生产"
          },
          {
            "type": "执行·停止",
            "config": "正常生产"
          },
          {
            "type": "状态·清除报警",
            "config": ""
          }
        ],
        "binding": ""
      }
    },
    "fixedBars": {
      "top": false,
      "bottom": true,
      "left": false,
      "right": false,
      "cameraBind": "未绑定",
      "commBind": "TCP.连接状态",
      "showRunStatus": true,
      "showOkNg": true,
      "showCounters": true,
      "showHistory": true,
      "gateKey": "passGate"
    },
    "meta": {
      "template": "host_sm_default",
      "version": 2,
      "openAndRun": true
    }
  },
  "notes": "【默认产线 · 上位机运行壳】胶片条已挂 circle/caliper/fixture 样张。设计态 ▶ 单次：预处理→圆查找→测量→变量；或切「运行模式」用操作员界面开始/停止。无需预先「打开图像」——打开工程会自动载入第一张。\n【细妆】默认运行壳：图像 + 上位机状态机（p41–43）；底栏 OK/NG/计数；无机械手 SDK。\n【开箱】样张使用仓库相对路径（public/vision/samples/…），换机/换目录仍可自动载入。\n【wave145】open-and-run 审计：菜单/README 覆盖全量样例；条码密度铬已补齐。",
  "globalTriggers": {
    "events": [],
    "strings": [
      {
        "event": "RUN",
        "match": "RUN",
        "partial": false,
        "commandType": "执行·单次",
        "config": "",
        "enabled": true
      },
      {
        "event": "STOP",
        "match": "STOP",
        "partial": false,
        "commandType": "执行·停止",
        "config": "",
        "enabled": true
      }
    ]
  },
  "commManager": {
    "devices": [
      {
        "name": "LocalLoop",
        "protocol": "Local Bus",
        "host": "",
        "port": 0,
        "enabled": true,
        "remark": "进程内事件总线（桌面演示；流程 send↔receive 同进程互通）"
      },
      {
        "id": "trigger-listen",
        "name": "TriggerListen",
        "protocol": "TCP Server",
        "host": "127.0.0.1",
        "port": 19777,
        "enabled": true,
        "remark": "全局触发直播监听：向 127.0.0.1:19777 发送 RUN 即可执行·单次"
      }
    ],
    "recvEvents": [
      {
        "name": "触发字串",
        "device": "TriggerListen",
        "message": "",
        "topic": "",
        "variable": "flow.commLastRecv"
      },
      {
        "name": "Local注入",
        "device": "LocalLoop",
        "message": "",
        "topic": "",
        "variable": "flow.commLastRecv"
      }
    ],
    "sendEvents": [],
    "heartbeat": {
      "enabled": true,
      "intervalMs": 5000,
      "payload": "HB"
    },
    "response": {
      "enabled": true,
      "timeoutMs": 3000,
      "ack": "OK"
    }
  }
}
