  "name": "打开即跑 · Python 脚本",
  "steps": [
    {
      "id": "deafed79249844df",
      "operation": "script",
      "name": "脚本计数",
      "params": {
        "code": "def run(ctx):\n    # 打开即跑：无 OpenCV 依赖，纯结果回写\n    n = int(ctx.get(\"params\", {}).get(\"count\", 3))\n    return dict(result=dict(count=n, passed=n>0, note=\"script-ok\"))\n",
        "timeoutMs": 5000,
        "arguments": {
          "count": 3
        },
        "outputBindings": [
          {
            "field": "passed",
            "scope": "flow",
            "name": "passed"
          },
          {
            "field": "count",
            "scope": "flow",
            "name": "scriptCount"
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 160
      }
    }
  ],
