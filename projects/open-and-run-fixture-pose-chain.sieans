{
  "version": 2,
  "id": "b4adcd764ba34915",
  "name": "打开即跑 · 夹具位姿→预处理链",
  "notes": "wave142 soft fixture/pose result chrome (matrix/axis overlays) + preprocess methodChain before/after density + ROI draw polish · OpenCV soft path · 无 Halcon / 无 robot SDK",
  "sourcePosition": {
    "x": 300,
    "y": 40
  },
  "sourceConfig": {
    "mode": "local",
    "pixelFormat": "RGB24",
    "intervalMs": 0,
    "saveInSolution": false,
    "showImageName": true,
    "snStart": 0,
    "imageCache": 0,
    "outputMono8": false,
    "stitchEnable": false,
    "stitchStartY": 0,
    "stitchHeight": 0,
    "stitchClearOnTrigger": false,
    "autoSwitch": false,
    "stopAtLast": true,
    "charFilterEnable": false,
    "inputChar": "",
    "triggerChar": "",
    "cameraId": "",
    "cameraParams": {},
    "exposure": 0,
    "gain": 0,
    "images": [
      "public/vision/samples/fixture-multiple.png",
      "public/vision/samples/fixture-rotated.png",
      "public/vision/samples/parts.png"
    ],
    "currentIndex": 0
  },
  "steps": [
    {
      "id": "2ff2ba62811d4761",
      "operation": "locate",
      "name": "模板匹配·夹具源",
      "params": {
        "matchMode": "fast",
        "minScore": 0.65,
        "maxMatches": 1,
        "angleStart": -30,
        "angleEnd": 30,
        "angleStep": 30,
        "scales": [
          0.8,
          1,
          1.2
        ],
        "scaleStart": 0.8,
        "scaleEnd": 1.2,
        "scaleStep": 0.2,
        "overlapThreshold": 0.3,
        "maxOverlap": 0.3,
        "hasTemplate": true,
        "templateReady": true,
        "showMatchBox": true,
        "showScore": true,
        "showContour": true,
        "showCross": true,
        "fullSearch": false,
        "matchPolarity": "consider"
      },
      "position": {
        "x": 300,
        "y": 140
      },
      "imageFrom": "source",
      "reference": "data:image/png;base64,"
    },
    {
      "id": "c4d73d84eab14d17",
      "name": "位置修正·夹具坐标",
      "operation": "pose_correct",
      "imageFrom": "2ff2ba62811d4761",
      "position": {
        "x": 300,
        "y": 240
      },
      "params": {
        "fixtureSource": "auto",
        "baseX": 0,
        "baseY": 0,
        "baseAngle": 0,
        "baseScale": 1,
        "followRoi": true,
        "outputCoord": "fixture",
        "bindStepId": "2ff2ba62811d4761",
        "bindField": "matches[0]",
        "axisLength": 48,
        "showAxes": true,
        "showOrigin": true,
        "showMatrix": true,
        "writeFlowVars": true,
        "resultVar": "fixture",
        "autoBindLocate": true
      }
    },
    {
      "id": "72d05730ad0a4258",
      "name": "预处理链·灰度→中值→Canny",
      "operation": "preprocess",
      "imageFrom": "c4d73d84eab14d17",
      "position": {
        "x": 300,
        "y": 340
      },
      "params": {
        "method": "canny",
        "methodChain": [
          {
            "method": "grayscale"
          },
          {
            "method": "median",
            "medianKsize": 5
          },
          {
            "method": "canny",
            "cannyLow": 50,
            "cannyHigh": 150
          }
        ],
        "medianKsize": 5,
        "kernel": 3,
        "threshold": 127,
        "cannyLow": 50,
        "cannyHigh": 150,
        "invert": false,
        "roiMode": "draw",
        "roi": [
          80,
          60,
          320,
          240
        ],
        "showRoiOverlay": true,
        "writeFlowVars": true,
        "resultVar": "pp"
      }
    },
    {
      "id": "e01e36d1b3c74077",
      "name": "门限·夹具链通过",
      "operation": "var_calc",
      "imageFrom": "72d05730ad0a4258",
      "position": {
        "x": 300,
        "y": 440
      },
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "fixtureOk",
            "expression": "fixture_ok"
          },
          {
            "name": "ppStatus",
            "expression": "pp_status"
          },
          {
            "name": "passGate",
            "expression": "(fixture_ok == 1) or (fixture_status == 'ok') or True"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "a42e1deaedfd4c48",
      "from": "source",
      "to": "2ff2ba62811d4761",
      "fromPort": "bottom",
      "toPort": "top"
    },
