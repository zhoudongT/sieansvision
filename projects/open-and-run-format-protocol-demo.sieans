  "commManager": {
    "devices": [
      {
        "id": "local-loop",
        "name": "LocalLoop",
        "protocol": "Local Bus",
        "enabled": true,
        "host": "",
        "port": 0
      },
      {
        "id": "trigger-listen",
        "name": "TriggerListen",
        "protocol": "TCP Server",
        "host": "127.0.0.1",
        "port": 19777,
        "enabled": true,
        "remark": "全局触发直播监听：向 127.0.0.1:19777 发送 RUN 即可执行·单次"
