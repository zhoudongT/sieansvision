{
  "version": 2,
  "id": "48a5705a52cf4bbb",
  "name": "打开即跑 · 匹配定位候选铬",
  "steps": [
    {
      "id": "a1b2c3d4e5f64789",
      "operation": "locate",
      "name": "多候选匹配·铬",
      "params": {
        "matchMode": "fast",
        "minScore": 0.55,
        "maxMatches": 8,
        "angleStart": -45,
        "angleEnd": 45,
        "angleStep": 15,
        "scales": [
          0.85,
          1.0,
          1.15
        ],
        "scaleStart": 0.85,
        "scaleEnd": 1.15,
        "scaleStep": 0.15,
        "overlapThreshold": 0.35,
        "maxOverlap": 0.35,
        "hasTemplate": true,
        "templateReady": true,
        "showMatchBox": true,
        "showScore": true,
        "showContour": true,
        "fullSearch": false,
        "matchPolarity": "consider",
        "showCross": true,
        "showRank": true,
        "showMargin": true,
        "judgeEnable": true,
        "judgeMin": 0.55,
        "judgeMax": 1.0,
        "resultVar": "matchLocate"
      },
      "reference": "data:image/png;base64,",
      "position": {
        "x": 300,
        "y": 160
      },
      "imageFrom": "source"
    },
    {
      "id": "b2c3d4e5f6478901",
      "operation": "var_calc",
      "name": "匹配门限·OK/NG",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "matchScore",
            "expr": "steps[\"a1b2c3d4e5f64789\"].score",
            "enabled": true
          },
          {
            "name": "matchCount",
            "expr": "len(steps[\"a1b2c3d4e5f64789\"].matches or steps[\"a1b2c3d4e5f64789\"].items or [])",
            "enabled": true
          },
          {
            "name": "passGate",
            "expr": "(steps[\"a1b2c3d4e5f64789\"].score or 0) >= 0.55",
            "enabled": true
          },
          {
            "name": "matchOk",
            "expr": "flow.passGate",
            "enabled": true
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 320
      },
      "imageFrom": "a1b2c3d4e5f64789"
    }
  ],
  "edges": [
    {
      "id": "4ca11339ef5f4195",
      "from": "source",
      "to": "a1b2c3d4e5f64789",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "43d91cb08fe54e84",
      "from": "a1b2c3d4e5f64789",
      "to": "b2c3d4e5f6478901",
