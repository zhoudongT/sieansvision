  "commManager": {
    "devices": [
      {
        "id": "local-loop",
        "name": "LocalLoop",
        "protocol": "Local Bus",
        "enabled": true,
        "host": "",
        "port": 0
      },
      {
        "id": "tcp-client",
        "name": "TcpClient",
