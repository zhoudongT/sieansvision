        "enabled": true,
        "host": "127.0.0.1",
        "port": 19880,
        "remark": "不可达时走回显模拟器；冒烟用 simulator fallback"
      },
      {
        "id": "udp-peer",
        "name": "UdpPeer",
        "protocol": "UDP",
        "enabled": true,
