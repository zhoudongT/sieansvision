    {
      "id": "df63d7dd68bf4891",
      "operation": "send_data",
      "name": "LocalBus写出样例",
      "params": {
        "device": "LocalLoop",
        "channel": "default",
        "sourceMode": "variable",
        "sourceScope": "flow",
        "sourceVar": "samplePayload",
        "message": "",
        "encoding": "utf-8",
        "appendCrLf": false
      },
      "position": {
        "x": 300,
        "y": 200
      },
      "variables": {},
      "imageFrom": "4ea5c66337814545"
    },
    {
      "id": "a999c3edd3a4478a",
      "operation": "receive_data",
      "name": "LocalBus读回",
      "params": {
        "device": "LocalLoop",
        "channel": "default",
        "timeoutMs": 500,
        "encoding": "utf-8",
        "targetScope": "flow",
        "targetVar": "recvData",
        "triggerOnReceive": true
      },
      "position": {
        "x": 300,
        "y": 310
      },
      "variables": {},
      "imageFrom": "df63d7dd68bf4891"
    },
    {
      "id": "0892fe9c919548aa",
      "operation": "protocol_parse",
      "name": "协议解析(recvData)",
      "params": {
        "sourceVar": "recvData",
        "protocol": "delimited",
        "delimiter": ",",
        "fields": "status,value,judge",
        "pattern": "",
        "fixedWidths": "8,8,16",
        "targetPrefix": "parsed_",
        "sourceScope": "flow"
      },
      "position": {
        "x": 300,
        "y": 420
      },
      "imageFrom": "a999c3edd3a4478a"
    },
    {
      "id": "eb366fbcb9cb43b6",
      "operation": "format_data",
      "name": "格式化输出",
      "params": {
        "template": "STATUS={0} VALUE={1} JUDGE={2}",
        "args": "parsed_status,parsed_value,parsed_judge",
        "targetVar": "formatted",
        "scope": "flow",
        "emptyDefault": ""
      },
      "position": {
        "x": 300,
        "y": 530
      },
      "imageFrom": "0892fe9c919548aa"
    },
    {
      "id": "010e4c6014c6443b",
      "operation": "var_calc",
      "name": "判定与回写",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "passGate",
            "expression": "1",
            "initial": 1,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "lastFormatted",
            "expression": "formatted",
            "initial": "",
            "outType": "string",
            "initOnRun": true
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 640
      },
      "imageFrom": "eb366fbcb9cb43b6"
    }
  ],
