        "port": 19881,
        "remark": "不可达时走 UDP 回显模拟器"
      },
      {
        "id": "trigger-listen",
        "name": "TriggerListen",
        "protocol": "TCP Server",
        "host": "127.0.0.1",
        "port": 19777,
        "enabled": true,
        "remark": "RUN 触发口"
      }
    ],
    "sendEvents": [
      {
        "device": "LocalLoop",
        "variable": "flow.commPayload",
        "message": ""
