{
  "version": 2,
  "id": "fd7b0ffe954b479e",
  "name": "打开即跑 · 条码/ID密度铬",
  "steps": [
    {
      "id": "ce0d667af2f546b0",
      "operation": "barcode",
      "name": "多码识别·铬",
      "params": {
        "maxCodes": 5,
        "types": "all",
        "showOverlay": true,
        "showBoxes": true,
        "showText": true,
        "showFormat": true,
        "showIndex": true,
        "resultVar": "barcode",
        "writeFlowVars": true,
        "judgeEnable": true,
        "expectedText": "MACHINE-QR-2026",
        "judgeMinCount": 1,
        "judgeMaxCount": 0
      },
      "position": {
        "x": 300,
        "y": 160
      },
      "imageFrom": "source"
    },
    {
      "id": "a9b8c7d6e5f40321",
      "operation": "var_calc",
      "name": "条码门限·OK/NG",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "barcodeCount",
            "expr": "(steps[\"ce0d667af2f546b0\"].count or 0)",
            "enabled": true
          },
          {
            "name": "barcodeText",
            "expr": "(steps[\"ce0d667af2f546b0\"].items[0].text if (steps[\"ce0d667af2f546b0\"].items) else \"\")",
            "enabled": true
          },
          {
            "name": "barcodeOk",
            "expr": "(steps[\"ce0d667af2f546b0\"].count or 0) >= 1",
            "enabled": true
          },
          {
            "name": "passGate",
            "expr": "(steps[\"ce0d667af2f546b0\"].count or 0) >= 1",
            "enabled": true
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 300
      },
      "imageFrom": "ce0d667af2f546b0"
    }
  ],
  "edges": [
    {
      "id": "680558ce796d4540",
      "from": "source",
      "to": "ce0d667af2f546b0",
      "fromPort": "bottom",
