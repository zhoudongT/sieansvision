    {
      "id": "e81e35deff8e4e48",
      "operation": "var_calc",
      "name": "残差门限·门✓",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "calibRms",
            "expression": "nine_point_rms",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "calibPoints",
            "expression": "nine_point_count",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "calibOk",
            "expression": "nine_point_ok",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "passGate",
            "expression": "nine_point_ok > 0 && nine_point_count >= 9 && nine_point_rms < 0.5",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          }
        ],
        "gateVar": "passGate"
      },
      "position": {
        "x": 300,
        "y": 300
      },
      "imageFrom": "7ecf5e4659c9417a"
