{
  "version": 2,
  "id": "3563f5aaec47710b",
  "name": "打开即跑 · 轮廓→色彩区域",
  "notes": "wave141 soft contour/blob + color-region result chrome · OpenCV soft path · 无 Halcon / 无 robot SDK",
  "sourcePosition": {
    "x": 300,
    "y": 40
  },
  "sourceConfig": {
    "mode": "local",
    "pixelFormat": "RGB24",
    "intervalMs": 0,
    "saveInSolution": false,
    "showImageName": true,
    "snStart": 0,
    "imageCache": 0,
    "outputMono8": false,
    "stitchEnable": false,
    "stitchStartY": 0,
    "stitchHeight": 0,
    "stitchClearOnTrigger": false,
    "autoSwitch": false,
    "stopAtLast": true,
    "charFilterEnable": false,
    "inputChar": "",
    "triggerChar": "",
    "cameraId": "",
    "cameraParams": {},
    "exposure": 0,
    "gain": 0,
    "images": [
      "public/vision/samples/parts.png",
      "public/vision/samples/color-regions.png"
    ]
  },
  "steps": [
    {
      "id": "cc77395a3705442c",
      "operation": "preprocess",
      "name": "预处理·灰度",
      "params": {
        "method": "grayscale",
        "kernel": 3,
        "threshold": 128,
        "cannyLow": 50,
        "cannyHigh": 150,
        "invert": false,
        "roiMode": "inherit",
        "showRoiOverlay": false
      },
      "position": {
        "x": 300,
        "y": 140
      },
      "imageFrom": "source"
    },
    {
      "id": "9b50fcac703f4fc1",
      "operation": "geometry",
      "name": "轮廓/斑点查找",
      "params": {
        "feature": "contours",
        "roiMode": "inherit",
        "threshold": 80,
        "minArea": 80,
        "invert": false,
        "maxCount": 8,
        "showOverlay": true,
        "showPoints": true,
        "showLabels": true,
        "judgeEnable": true,
        "judgeMin": 100,
        "judgeMax": 999999,
        "findMethod": "auto",
        "cannyLow": 40,
        "cannyHigh": 140
      },
      "position": {
        "x": 300,
        "y": 240
      },
      "imageFrom": "previous"
    },
    {
      "id": "dce0800a4a7d4d3f",
      "operation": "plugin",
      "name": "HSV色彩区域",
      "params": {
        "pluginId": "sieans-regions",
        "pluginVersion": "1.0.0",
        "operatorId": "color",
        "arguments": {
          "method": "hsv",
          "hueMin": 170,
          "hueMax": 10,
          "saturationMin": 80,
          "saturationMax": 255,
          "valueMin": 60,
          "valueMax": 255,
          "roiX": 0,
          "roiY": 0,
          "roiWidth": 0,
          "roiHeight": 0,
          "minimumArea": 200,
          "maximumArea": 100000000,
          "minimumCount": 1,
          "maximumCount": 10,
          "excludeBorder": false,
          "connectivity": 8,
          "morphology": "none",
          "kernelSize": 3,
          "outputImage": "annotated",
          "showOverlay": true,
          "showBox": true,
          "showCross": true,
          "showLabels": true,
          "showEllipse": false
        },
        "outputBindings": [
          {
            "field": "count",
            "scope": "flow",
            "name": "colorCount"
          },
          {
            "field": "areaPixels",
            "scope": "flow",
            "name": "colorArea"
          },
          {
            "field": "passed",
            "scope": "flow",
            "name": "colorPassed"
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 340
      },
      "imageFrom": "source"
    },
    {
      "id": "c15195a0737744cf",
      "operation": "var_calc",
      "name": "门限·色彩通过",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "contourCount",
            "expression": "geometry_count"
          },
          {
            "name": "colorCount",
            "expression": "colorCount"
          },
          {
            "name": "passGate",
            "expression": "(geometry_count >= 1) or (colorCount >= 1)"
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 440
      },
      "imageFrom": "previous"
    }
  ],
  "edges": [
    {
      "id": "7cd9bd171dca42a4",
      "from": "source",
      "to": "cc77395a3705442c",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "cd544bce951240b2",
      "from": "cc77395a3705442c",
      "to": "9b50fcac703f4fc1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "a50231a0a56a4851",
      "from": "9b50fcac703f4fc1",
      "to": "dce0800a4a7d4d3f",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "18e2b8bef957432d",
      "from": "dce0800a4a7d4d3f",
      "to": "c15195a0737744cf",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ],
  "variables": {
    "flow": {}
  },
  "meta": {
    "openAndRun": true,
    "wave": 141
  },
  "runUi": {
    "split": "4",
    "placements": [
      {
        "name": "图像",
        "page": 3,
        "cell": 0,
        "category": "基础"
      },
      {
        "name": "OK/NG",
        "page": 3,
        "cell": 1,
        "category": "基础"
      },
      {
        "name": "运行控制",
        "page": 3,
        "cell": 2,
        "category": "基础"
      },
      {
        "name": "生产统计",
        "page": 3,
        "cell": 3,
        "category": "图表"
      }
    ],
    "controls": {
      "图像": {
        "commands": [],
        "binding": "source"
      },
      "OK/NG": {
        "commands": [],
        "binding": ""
      },
      "运行控制": {
        "commands": [
          {
            "type": "执行·单次",
            "config": ""
          },
          {
            "type": "执行·连续",
            "config": ""
          },
          {
            "type": "执行·停止",
            "config": ""
          }
        ],
        "binding": ""
      },
      "生产统计": {
        "commands": [],
        "binding": "stats"
      }
    },
    "fixedBars": {
      "top": false,
      "bottom": true,
      "left": false,
      "right": false,
      "cameraBind": "未绑定",
      "commBind": "TCP.连接状态",
      "showRunStatus": true,
      "showOkNg": true,
      "showCounters": true,
      "showHistory": true
    },
    "meta": {
      "template": "open_and_run_contour_color",
      "version": 1,
      "openAndRun": true,
      "wave": 145
    }
  }
}
