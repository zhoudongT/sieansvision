          {
            "id": "153f422383c34c88",
            "name": "交点·垂距门限·OK/NG",
            "operation": "var_calc",
            "params": {
              "scope": "flow",
              "expressions": [
                {
                  "name": "lineCount",
                  "expression": "geometry_count",
                  "initial": 0,
                  "outType": "number",
                  "initOnRun": true
                },
                {
                  "name": "lineScore",
                  "expression": "geometry_score",
                  "initial": 0,
                  "outType": "number",
                  "initOnRun": true
                },
                {
                  "name": "intersectX",
                  "expression": "line_intersect_x",
                  "initial": 0,
                  "outType": "number",
                  "initOnRun": true
                },
                {
                  "name": "intersectY",
                  "expression": "line_intersect_y",
                  "initial": 0,
                  "outType": "number",
                  "initOnRun": true
                },
                {
                  "name": "pldDist",
                  "expression": "point_line_distance_distance",
                  "initial": 0,
                  "outType": "number",
                  "initOnRun": true
                },
                {
                  "name": "passGate",
                  "expression": "lineCount >= 2 && lineScore >= 0.35 && line_intersect_ok == 1",
                  "initial": 0,
                  "outType": "number",
                  "initOnRun": true
                }
              ]
            },
            "imageFrom": "970477979fba492f"
          }
