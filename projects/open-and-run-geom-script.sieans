{
  "version": 2,
  "id": "815411c5f24b4385",
  "name": "打开即用·几何夹角圆距+脚本",
  "steps": [
    {
      "id": "b87828c60bdb4cab",
      "operation": "preprocess",
      "name": "图像预处理",
      "params": {
        "method": "grayscale",
        "threshold": 127,
        "kernel": 3,
        "cannyLow": 50,
        "cannyHigh": 150,
        "invert": false,
        "blur": 1
      },
      "position": {
        "x": 300,
        "y": 140
      },
      "imageFrom": "source"
    },
    {
      "id": "71b774e5bad94904",
      "operation": "line_angle",
      "name": "线与线夹角",
      "params": {
        "mode": "manual",
        "x1": 20,
        "y1": 80,
        "x2": 220,
        "y2": 80,
        "x3": 120,
        "y3": 20,
        "x4": 120,
        "y4": 160,
        "unit": "deg",
        "scale": 1.0,
        "showOverlay": true,
        "parallelTolDeg": 0.001,
        "perpTolDeg": 0.5,
        "judgeEnable": true,
        "judgeMin": 85,
        "judgeMax": 95,
        "resultVar": "lineAngle",
        "writeFlowVars": true
      },
      "position": {
        "x": 300,
        "y": 240
      },
      "imageFrom": "b87828c60bdb4cab"
    },
    {
      "id": "58ed5d2a035747f2",
      "operation": "point_circle_distance",
      "name": "点与圆距离",
      "params": {
        "mode": "manual",
        "px": 200,
        "py": 100,
        "cx": 120,
        "cy": 100,
        "radius": 30,
        "circleMode": "edge",
        "unit": "px",
        "scale": 1.0,
        "showOverlay": true,
        "judgeEnable": true,
        "judgeMin": 0,
        "judgeMax": 120,
        "resultVar": "pointCircle",
        "writeFlowVars": true
      },
      "position": {
        "x": 300,
        "y": 340
      },
      "imageFrom": "b87828c60bdb4cab"
    },
    {
      "id": "56d19f91802b4082",
      "operation": "circle_circle_distance",
      "name": "圆与圆距离",
      "params": {
        "mode": "manual",
        "cx1": 70,
        "cy1": 140,
        "r1": 22,
        "cx2": 160,
        "cy2": 140,
        "r2": 20,
        "circleMode": "gap",
        "unit": "px",
        "scale": 1.0,
        "showOverlay": true,
        "judgeEnable": true,
        "judgeMin": -10,
        "judgeMax": 80,
        "resultVar": "circleGap",
        "writeFlowVars": true
      },
      "position": {
        "x": 300,
        "y": 440
      },
      "imageFrom": "b87828c60bdb4cab"
    },
    {
      "id": "0c7afa5f5b564216",
      "operation": "csharp_script",
      "name": "C#脚本(Python)",
      "params": {
        "language": "python",
        "timeoutMs": 5000,
        "entry": "Script.Run",
        "writeOutputVars": true,
        "injectGlobals": true,
        "inputs": [
          {
            "name": "angle",
            "type": "number",
            "bind": "flow.lineAngle"
          },
          {
            "name": "gap",
            "type": "number",
            "bind": "flow.circleGap"
          },
          {
            "name": "pcd",
            "type": "number",
            "bind": "flow.pointCircle"
          }
        ],
        "outputs": [
          {
            "name": "out0",
            "type": "number"
          },
          {
            "name": "out1",
            "type": "number"
          }
        ],
        "code": "def run(ctx):\n    inj = ctx.get('params') or {}\n    angle = inj.get('angle')\n    gap = inj.get('gap')\n    pcd = inj.get('pcd')\n    result = dict(passed=True, out0=angle, out1=gap, pcd=pcd, note='geom→script soft inject')\n    return dict(result=result)\n"
      },
      "position": {
        "x": 300,
        "y": 540
      },
      "imageFrom": "b87828c60bdb4cab"
    },
    {
      "id": "d4fe3f8a5f6b42e7",
      "operation": "var_calc",
      "name": "变量计算",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "combo",
            "expression": "lineAngle",
            "initial": 0,
            "outType": "number",
            "initOnRun": false
          },
          {
            "name": "gapEcho",
            "expression": "circleGap",
            "initial": 0,
            "outType": "number",
            "initOnRun": false
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 640
      },
      "imageFrom": "b87828c60bdb4cab"
    }
  ],
  "edges": [
