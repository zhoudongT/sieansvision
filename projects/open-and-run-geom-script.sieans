      "snapshot": {
        "steps": [
          {
            "id": "88437751b6394bfd",
            "name": "图像预处理",
            "operation": "preprocess",
            "params": {
              "method": "grayscale",
              "threshold": 127,
              "kernel": 3,
              "cannyLow": 50,
              "cannyHigh": 150,
              "invert": false,
              "blur": 1
            },
            "imageFrom": "source"
          },
          {
            "id": "a511881928374398",
            "name": "卡尺直线查找",
            "operation": "geometry",
            "params": {
              "feature": "lines",
              "findMethod": "caliper",
              "roiPreset": "center",
              "caliperCount": 16,
              "caliperWidth": 18,
              "caliperLength": 220,
              "caliperSigma": 1.0,
              "caliperProjAngle": 0.0,
              "edgeType": "all",
              "edgePolarity": "any",
              "edgeThreshold": 25,
              "searchDir": "left_right",
              "maxCount": 3,
              "minScore": 0.35,
              "minLength": 40,
              "maximumResidual": 3.0,
              "rejectPoints": 1,
              "showOverlay": true,
              "showPoints": true,
              "showCalipers": true,
              "showFitCurve": true,
              "showFitError": true,
              "showLabels": true,
              "showRuler": true,
              "subPixel": true,
              "filterSize": 1
            },
            "imageFrom": "88437751b6394bfd"
          },
          {
            "id": "f28467b7a8134cde",
            "name": "两直线交点",
            "operation": "line_intersect",
            "params": {
              "mode": "bind",
              "line1From": "a511881928374398",
              "line1Field": "lines[0]",
              "line2From": "a511881928374398",
              "line2Field": "lines[1]",
              "unit": "px",
              "scale": 1.0,
              "showOverlay": true,
              "showPoints": true,
              "showLines": true,
              "showLabels": true,
              "showDistanceText": true,
              "x1": 0,
              "y1": 0,
              "x2": 100,
              "y2": 0,
              "x3": 50,
              "y3": -50,
              "x4": 50,
              "y4": 50
            },
            "imageFrom": "a511881928374398"
          },
          {
            "id": "970477979fba492f",
            "name": "交点到线3垂距",
            "operation": "point_line_distance",
            "params": {
              "mode": "bind",
              "pointFrom": "f28467b7a8134cde",
