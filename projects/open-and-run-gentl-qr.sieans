{
  "version": 2,
  "id": "open-and-run-gentl-qr-t238",
  "name": "打开即跑 · GenTL/Soft→二维码→TCP",
  "meta": {
    "openAndRun": true,
    "wave": 246,
    "camera": "gentl",
    "comms": "localbus+tcpReal-seed",
    "hangSafeContinuous": true,
    "hangFix": "t246u"
  },
  "notes": "wave4: soft letterbox sample-qr; LocalBus echo; receive roundtrip; TCP autoStart",
  "sourcePosition": {
    "x": 300,
    "y": 40
  },
  "sourceConfig": {
    "mode": "local",
    "pixelFormat": "RGB24",
    "intervalMs": 200,
    "saveInSolution": false,
    "showImageName": true,
    "snStart": 0,
    "imageCache": 0,
    "outputMono8": false,
    "stitchEnable": false,
    "stitchStartY": 0,
    "stitchHeight": 0,
    "stitchClearOnTrigger": false,
    "autoSwitch": false,
    "stopAtLast": false,
    "charFilterEnable": false,
    "inputChar": "",
    "triggerChar": "",
    "cameraId": "Hikrobot MV-CB013-A0UM-C (K13917662)",
    "cameraParams": {
      "driver": "gentl",
      "providerId": "8ae6d0c0a0009dd6b793",
      "deviceId": "Hikrobot MV-CB013-A0UM-C (K13917662)",
      "dataMode": "image",
      "trigger": "freerun",
      "timeoutMs": 5000,
      "keepConnectionOpen": true,
      "openClosePerGrab": false,
      "backendKind": "gentl",
      "continuousLive": true,
      "sessionPersist": true,
      "exposureTime": 2000,
      "acquisitionFrameRate": 15,
      "gainDb": 0
    },
    "exposure": 0.0,
    "gain": 0.0,
    "images": [],
    "currentIndex": 0
  },
  "steps": [
    {
      "id": "a1b2c3d4e5f60718",
      "name": "MV GenTL 采集",
      "operation": "camera_capture",
      "params": {
        "driver": "gentl",
        "providerId": "8ae6d0c0a0009dd6b793",
        "deviceId": "Hikrobot MV-CB013-A0UM-C (K13917662)",
        "dataMode": "image",
        "trigger": "freerun",
        "timeoutMs": 5000,
        "keepConnectionOpen": true,
        "openClosePerGrab": false,
        "backendKind": "gentl",
        "continuousLive": true,
        "sessionPersist": true,
        "reconnectResilient": true,
        "exposureTime": 2000,
        "acquisitionFrameRate": 15
      },
      "reference": "",
      "position": {
        "x": 300,
        "y": 160
      },
      "imageFrom": "source",
      "variables": {}
    },
    {
      "id": "b2c3d4e5f6071829",
      "operation": "barcode",
      "name": "二维码/条码识别",
      "params": {
        "maxCodes": 16,
        "types": "QRCode",
        "showOverlay": true,
        "showBoxes": true,
        "showText": true,
        "showFormat": true,
        "showIndex": true,
        "resultVar": "barcode",
        "writeFlowVars": true,
        "judgeEnable": true,
        "expectedText": "",
        "judgeMinCount": 1,
        "judgeMaxCount": 0
      },
      "position": {
        "x": 300,
        "y": 300
      },
      "imageFrom": "a1b2c3d4e5f60718",
      "variables": {}
    },
    {
      "id": "c3d4e5f60718293a",
      "operation": "var_calc",
      "name": "变量计算 · OK/NG",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "passGate",
            "expr": "barcodeCount >= 1",
            "enabled": true
          },
          {
            "name": "barcodeOk",
            "expr": "barcodeCount >= 1",
            "enabled": true
          },
          {
            "name": "urlOk",
            "expr": "startswith(barcodeText, \"http\")",
            "enabled": true
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 440
      },
      "imageFrom": "b2c3d4e5f6071829",
      "variables": {}
    },
    {
      "id": "g7b8193a4b5c6d7e",
      "name": "结果门限 OK/NG",
      "operation": "result_gate",
      "position": {
        "x": 300,
        "y": 500
      },
      "imageFrom": "c3d4e5f60718293a",
      "runState": "等待执行",
      "params": {
        "sourceVar": "barcodeCount",
        "minCount": 1,
        "passVar": "passGate"
      }
    },
    {
      "id": "d4e5f60718293a4b",
      "operation": "format_data",
      "name": "格式化二维码报文",
      "params": {
        "template": "BARCODE ok={passGate} count={barcodeCount} text={barcodeText}",
        "args": "passGate,barcodeCount,barcodeText",
        "targetVar": "formatted",
        "scope": "flow",
        "emptyDefault": "BARCODE empty"
      },
      "reference": "",
      "position": {
        "x": 300,
        "y": 620
      },
      "imageFrom": "g7b8193a4b5c6d7e",
      "variables": {}
    },
    {
      "id": "e5f60718293a4b5c",
      "operation": "send_data",
      "name": "LocalBus发送·二维码",
      "params": {
        "device": "LocalLoop",
        "channel": "default",
        "sourceMode": "text",
        "sourceScope": "flow",
        "sourceVar": "",
        "message": "BARCODE ok=${flow.passGate} count=${flow.barcodeCount} text=${flow.barcodeText}",
        "encoding": "utf-8",
        "appendCrLf": false,
        "prefix": "",
        "suffix": ""
      },
      "reference": "",
      "position": {
        "x": 300,
        "y": 740
      },
      "imageFrom": "d4e5f60718293a4b",
      "variables": {}
    },
    {
      "id": "f6a708293a4b5c6d",
      "name": "接收回环",
      "operation": "receive_data",
      "position": {
        "x": 300,
        "y": 860
      },
      "imageFrom": "e5f60718293a4b5c",
      "runState": "等待执行",
      "params": {
        "device": "LocalLoop",
        "targetVar": "lastRecv",
        "timeoutMs": 200
      }
    },
    {
      "id": "cond1",
      "name": "条件判断",
      "operation": "condition",
      "imageFrom": "g7b8193a4b5c6d7e",
      "position": {
        "x": 520,
        "y": 500
      },
      "params": {
        "logic": "and",
        "comparison": "gte",
        "left": "barcodeCount",
        "right": 1,
        "writePassGate": false,
        "rules": [
          {
            "left": "barcodeCount",
            "comparison": "gte",
            "right": 1,
            "enabled": true
          }
        ]
      }
    },
    {
      "id": "taken1",
      "name": "成立分支",
      "operation": "format_data",
      "imageFrom": "cond1",
      "position": {
        "x": 460,
        "y": 640
      },
      "params": {
        "template": "ROUTE=OK",
        "args": "",
        "targetVar": "branchRoute"
      }
    },
    {
      "id": "skipped1",
      "name": "不成立分支",
      "operation": "format_data",
      "imageFrom": "cond1",
      "position": {
        "x": 680,
        "y": 640
      },
      "params": {
        "template": "ROUTE=NG",
        "args": "",
        "targetVar": "branchRoute"
      }
    },
    {
      "id": "merge1",
      "name": "分支汇合",
      "operation": "branch_merge",
      "imageFrom": "taken1",
      "position": {
        "x": 560,
        "y": 760
      },
      "params": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "source",
      "to": "a1b2c3d4e5f60718",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e2",
      "from": "a1b2c3d4e5f60718",
      "to": "b2c3d4e5f6071829",
