    },
    {
      "id": "e3",
      "from": "b2c3d4e5f6071829",
      "to": "c3d4e5f60718293a",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e3b",
      "from": "c3d4e5f60718293a",
      "to": "g7b8193a4b5c6d7e",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e3c",
      "from": "g7b8193a4b5c6d7e",
      "to": "d4e5f60718293a4b",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e5",
      "from": "d4e5f60718293a4b",
      "to": "e5f60718293a4b5c",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e6",
      "from": "e5f60718293a4b5c",
      "to": "f6a708293a4b5c6d",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e-cond-in",
      "from": "g7b8193a4b5c6d7e",
      "to": "cond1",
      "fromPort": "bottom",
      "toPort": "top",
      "when": "always"
    },
    {
      "id": "e-cond-true",
      "from": "cond1",
      "to": "taken1",
      "fromPort": "bottom",
      "toPort": "top",
      "when": "true"
    },
    {
      "id": "e-cond-false",
      "from": "cond1",
      "to": "skipped1",
      "fromPort": "right",
      "toPort": "top",
      "when": "false"
    },
    {
      "id": "e-merge-ok",
      "from": "taken1",
      "to": "merge1",
      "fromPort": "bottom",
      "toPort": "top",
      "when": "always"
    },
    {
      "id": "e-merge-ng",
      "from": "skipped1",
      "to": "merge1",
      "fromPort": "bottom",
      "toPort": "top",
      "when": "always"
    }
  ],
  "variables": {
    "barcodeCount": 0,
    "barcodeText": "",
    "barcodeAll": "",
    "barcodeOk": 0,
    "passGate": 0,
    "formatted": "",
    "commPayload": "",
    "lastRecv": "",
    "conditionPassed": 0,
    "conditionOk": 0,
    "branchTaken": "",
    "branchRoute": "",
    "mergeFrom": "",
    "skippedCount": 0
  },
  "hostWatch": {
    "watchKeys": [
      "barcodeCount",
      "barcodeText",
      "barcodeAll",
      "barcodeOk",
      "passGate",
      "formatted",
      "urlOk",
      "lastRecv",
      "conditionPassed",
      "branchTaken",
      "branchRoute",
      "mergeFrom",
      "skippedCount"
    ],
    "active": "二维码链",
    "pinGroups": {
      "二维码链": [
        "barcodeCount",
        "barcodeText",
        "barcodeAll",
        "barcodeOk",
        "passGate",
        "urlOk",
        "formatted"
      ],
      "门限": [
        "barcodeOk",
        "passGate",
        "urlOk"
      ],
      "通信": [
        "formatted",
        "passGate",
        "barcodeText",
        "lastRecv",
        "urlOk"
      ]
    }
  },
  "runUi": {
    "split": "4",
    "placements": [
      {
        "name": "图像",
        "page": 3,
        "cell": 0,
        "category": "基础"
      },
      {
        "name": "OK/NG",
        "page": 3,
        "cell": 1,
        "category": "基础"
      },
      {
        "name": "运行控制",
        "page": 3,
        "cell": 2,
        "category": "基础"
      },
      {
        "name": "生产统计",
        "page": 3,
        "cell": 3,
        "category": "图表"
      }
    ],
    "controls": {
      "图像": {
        "commands": [],
        "binding": "source"
      },
      "OK/NG": {
        "commands": [],
        "binding": "passGate",
        "chrome": "barcode"
      },
      "运行控制": {
        "commands": [
          {
            "type": "执行·单次",
            "config": ""
          },
          {
            "type": "执行·连续",
            "config": ""
          },
          {
            "type": "执行·停止",
            "config": ""
          }
        ],
        "binding": ""
      },
      "生产统计": {
        "commands": [],
        "binding": "stats"
      }
    },
    "fixedBars": {
      "top": false,
      "bottom": true,
      "left": false,
      "right": false,
      "cameraBind": "GenTL.MV-CB013",
      "commBind": "TCP.连接状态",
      "showRunStatus": true,
      "showOkNg": true,
      "showCounters": true,
      "showHistory": true
    },
    "meta": {
      "template": "open_and_run_gentl_qr",
      "version": 2,
      "openAndRun": true,
      "wave": 242,
      "hangFix": "t240u-continuous-reentry-live-paint",
      "comms": "localbus-barcode-send",
      "sessionPersist": true
    }
  },
  "commManager": {
    "devices": [
      {
        "id": "local-loop",
        "name": "LocalLoop",
        "protocol": "Local Bus",
        "enabled": true,
        "host": "",
        "port": 0,
        "remark": "进程内总线：GenTL→QR→模板发送（无现场 TCP）"
      },
      {
        "id": "tcp-real-loopback",
        "name": "TcpRealLoopback",
        "protocol": "TCP Server",
        "enabled": true,
        "host": "127.0.0.1",
        "port": 19956,
        "remark": "可选真 TCP Server 环回（CommManager Real TCP；无 PLC/机器人）"
      }
    ],
    "recvEvents": [],
    "sendEvents": [
      {
        "name": "二维码结果行",
        "device": "LocalLoop",
        "message": "BARCODE ok=${flow.passGate} count=${flow.barcodeCount} text=${flow.barcodeText}",
        "topic": "",
        "variable": ""
      },
      {
        "name": "二维码 JSON",
        "device": "LocalLoop",
        "message": "{\"cmd\":\"BARCODE\",\"ok\":${flow.passGate},\"count\":${flow.barcodeCount},\"text\":\"${flow.barcodeText}\"}",
        "topic": "",
        "variable": ""
      }
    ],
    "heartbeat": {
      "enabled": false
    },
    "response": {},
    "messageTemplates": [
      {
        "id": "barcode-line",
        "name": "条码/二维码上报",
        "protocol": "line",
        "body": "BARCODE ok=${flow.passGate} count=${flow.barcodeCount} text=${flow.barcodeText}"
      },
      {
        "id": "qr-passgate",
        "name": "二维码门限行",
        "protocol": "line",
        "body": "QR ok=${flow.passGate} text=${flow.barcodeText}"
      }
    ],
    "tcpReal": {
      "host": "127.0.0.1",
      "port": 19956,
      "framing": "lf",
      "keepAlive": true,
      "reconnect": true,
      "role": "server",
      "ack": "OK",
      "autoStart": true,
      "payload": "BARCODE ok=${flow.passGate} text=${flow.barcodeText}"
    }
  },
  "runIntervalMs": 200,
  "flowIo": {
    "inputs": [
      {
        "name": "ImageData",
        "type": "IMAGE",
        "binding": "source.image"
      }
    ],
    "outputs": [
      {
        "name": "ImageData",
        "type": "IMAGE",
        "binding": "source.image"
      },
      {
        "name": "Result",
        "type": "JSON",
        "binding": "flow.formatted"
      },
      {
        "name": "PassGate",
        "type": "INT",
        "binding": "flow.passGate"
      }
    ],
    "display": {
      "globalImage": true,
      "note": "Qt VM I/O 绑定"
    }
  }
}
