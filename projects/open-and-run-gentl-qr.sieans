{
  "version": 2,
  "id": "open-and-run-gentl-qr-t238",
  "name": "打开即跑 · GenTL相机→二维码",
  "meta": {
    "openAndRun": true,
    "wave": 246,
    "camera": "gentl",
    "comms": "localbus+tcpReal-seed",
    "hangSafeContinuous": true,
    "hangFix": "t246u"
  },
  "notes": "t246u：连续 GenTL→QR UI 线程 JPEG 解码改线程池 + 节流 show_results/config；t245u idle pace（无 consumer 心跳）；t244u drop-old。Hikrobot MV-CB013。",
  "sourcePosition": {
    "x": 300,
    "y": 40
  },
  "sourceConfig": {
    "mode": "local",
    "pixelFormat": "RGB24",
    "intervalMs": 200,
    "saveInSolution": false,
    "showImageName": true,
    "snStart": 0,
    "imageCache": 0,
    "outputMono8": false,
    "stitchEnable": false,
    "stitchStartY": 0,
    "stitchHeight": 0,
    "stitchClearOnTrigger": false,
    "autoSwitch": false,
    "stopAtLast": false,
    "charFilterEnable": false,
    "inputChar": "",
    "triggerChar": "",
    "cameraId": "Hikrobot MV-CB013-A0UM-C (K13917662)",
    "cameraParams": {
      "driver": "gentl",
      "providerId": "8ae6d0c0a0009dd6b793",
      "deviceId": "Hikrobot MV-CB013-A0UM-C (K13917662)",
      "dataMode": "image",
      "trigger": "freerun",
      "timeoutMs": 5000,
      "keepConnectionOpen": true,
      "openClosePerGrab": false,
      "backendKind": "gentl",
      "continuousLive": true,
      "sessionPersist": true,
      "exposureTime": 2000,
      "acquisitionFrameRate": 15
    },
    "exposure": 0.0,
    "gain": 0.0,
    "images": [],
    "currentIndex": 0
  },
  "steps": [
    {
      "id": "a1b2c3d4e5f60718",
      "name": "MV GenTL 采集",
      "operation": "camera_capture",
      "params": {
        "driver": "gentl",
        "providerId": "8ae6d0c0a0009dd6b793",
        "deviceId": "Hikrobot MV-CB013-A0UM-C (K13917662)",
        "dataMode": "image",
        "trigger": "freerun",
        "timeoutMs": 5000,
        "keepConnectionOpen": true,
        "openClosePerGrab": false,
        "backendKind": "gentl",
        "continuousLive": true,
        "sessionPersist": true,
        "reconnectResilient": true,
        "exposureTime": 2000,
        "acquisitionFrameRate": 15
      },
      "reference": "",
      "position": {
        "x": 300,
        "y": 160
      },
      "imageFrom": "source",
      "variables": {}
    },
    {
      "id": "b2c3d4e5f6071829",
      "operation": "barcode",
      "name": "二维码/条码识别",
      "params": {
        "maxCodes": 8,
        "types": "QRCode",
        "showOverlay": true,
        "showBoxes": true,
        "showText": true,
        "showFormat": true,
        "showIndex": true,
        "resultVar": "barcode",
        "writeFlowVars": true,
        "judgeEnable": true,
        "expectedText": "",
        "judgeMinCount": 1,
        "judgeMaxCount": 0
      },
      "position": {
        "x": 300,
        "y": 300
      },
      "imageFrom": "a1b2c3d4e5f60718",
      "variables": {}
    },
    {
      "id": "c3d4e5f60718293a",
      "operation": "var_calc",
      "name": "二维码结果·OK/NG",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "barcodeCount",
            "expr": "(steps[\"b2c3d4e5f6071829\"].count or 0)",
            "enabled": true
          },
          {
            "name": "barcodeText",
            "expr": "(steps[\"b2c3d4e5f6071829\"].items[0].text if (steps[\"b2c3d4e5f6071829\"].items) else \"\")",
            "enabled": true
          },
          {
            "name": "barcodeAll",
            "expr": "(\"\\n\".join(i.text for i in (steps[\"b2c3d4e5f6071829\"].items or [])))",
            "enabled": true
          },
          {
            "name": "barcodeOk",
            "expr": "(steps[\"b2c3d4e5f6071829\"].count or 0) >= 1",
            "enabled": true
          },
          {
            "name": "passGate",
            "expr": "(steps[\"b2c3d4e5f6071829\"].count or 0) >= 1",
            "enabled": true
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 440
      },
      "imageFrom": "b2c3d4e5f6071829",
      "variables": {}
    },
    {
      "id": "d4e5f60718293a4b",
      "operation": "format_data",
      "name": "格式化二维码报文",
      "params": {
        "template": "BARCODE ok={0} count={1} text={2}",
        "args": "passGate,barcodeCount,barcodeText",
        "targetVar": "formatted",
        "scope": "flow",
        "emptyDefault": ""
      },
      "reference": "",
      "position": {
        "x": 300,
        "y": 560
      },
      "imageFrom": "c3d4e5f60718293a",
      "variables": {}
    },
    {
      "id": "e5f60718293a4b5c",
      "operation": "send_data",
      "name": "LocalBus发送·二维码",
      "params": {
        "device": "LocalLoop",
        "channel": "default",
        "sourceMode": "text",
        "sourceScope": "flow",
        "sourceVar": "",
        "message": "BARCODE ok=${flow.passGate} count=${flow.barcodeCount} text=${flow.barcodeText}",
        "encoding": "utf-8",
        "appendCrLf": false,
        "prefix": "",
        "suffix": ""
      },
      "reference": "",
      "position": {
        "x": 300,
        "y": 680
      },
      "imageFrom": "d4e5f60718293a4b",
      "variables": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "source",
      "to": "a1b2c3d4e5f60718",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e2",
      "from": "a1b2c3d4e5f60718",
      "to": "b2c3d4e5f6071829",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e3",
      "from": "b2c3d4e5f6071829",
      "to": "c3d4e5f60718293a",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e4",
      "from": "c3d4e5f60718293a",
      "to": "d4e5f60718293a4b",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "e5",
      "from": "d4e5f60718293a4b",
      "to": "e5f60718293a4b5c",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ],
  "variables": {
    "barcodeCount": 0,
    "barcodeText": "",
    "barcodeAll": "",
    "barcodeOk": 0,
    "passGate": 0,
    "formatted": "",
    "commPayload": ""
  },
  "hostWatch": {
    "watchKeys": [
      "barcodeCount",
      "barcodeText",
      "barcodeAll",
      "barcodeOk",
      "passGate",
      "formatted"
    ],
    "active": "二维码链",
    "pinGroups": {
      "二维码链": [
        "barcodeCount",
        "barcodeText",
        "barcodeAll",
        "barcodeOk",
        "passGate",
        "formatted"
      ],
      "门限": [
        "barcodeOk",
        "passGate"
      ],
      "通信": [
        "formatted",
        "passGate",
        "barcodeText"
      ]
    }
  },
  "runUi": {
    "split": "4",
    "placements": [
      {
        "name": "图像",
        "page": 3,
        "cell": 0,
        "category": "基础"
      },
      {
        "name": "OK/NG",
        "page": 3,
        "cell": 1,
        "category": "基础"
      },
      {
        "name": "运行控制",
        "page": 3,
        "cell": 2,
        "category": "基础"
      },
      {
        "name": "生产统计",
        "page": 3,
        "cell": 3,
        "category": "图表"
      }
    ],
    "controls": {
      "图像": {
        "commands": [],
        "binding": "source"
      },
      "OK/NG": {
        "commands": [],
        "binding": "passGate",
        "chrome": "barcode"
      },
      "运行控制": {
        "commands": [
          {
            "type": "执行·单次",
            "config": ""
          },
          {
            "type": "执行·连续",
            "config": ""
          },
          {
            "type": "执行·停止",
            "config": ""
          }
        ],
        "binding": ""
      },
      "生产统计": {
        "commands": [],
        "binding": "stats"
      }
    },
    "fixedBars": {
      "top": false,
      "bottom": true,
      "left": false,
      "right": false,
      "cameraBind": "GenTL.MV-CB013",
      "commBind": "TCP.连接状态",
      "showRunStatus": true,
      "showOkNg": true,
      "showCounters": true,
      "showHistory": true
    },
    "meta": {
      "template": "open_and_run_gentl_qr",
      "version": 2,
      "openAndRun": true,
      "wave": 242,
      "hangFix": "t240u-continuous-reentry-live-paint",
      "comms": "localbus-barcode-send",
      "sessionPersist": true
    }
  },
  "commManager": {
    "devices": [
      {
        "id": "local-loop",
        "name": "LocalLoop",
        "protocol": "Local Bus",
        "enabled": true,
        "host": "",
        "port": 0,
        "remark": "进程内总线：GenTL→QR→模板发送（无现场 TCP）"
      },
      {
        "id": "tcp-real-loopback",
        "name": "TcpRealLoopback",
        "protocol": "TCP Server",
        "enabled": true,
        "host": "127.0.0.1",
        "port": 19956,
        "remark": "可选真 TCP Server 环回（CommManager Real TCP；无 PLC/机器人）"
      }
    ],
    "recvEvents": [],
    "sendEvents": [
      {
        "name": "二维码结果行",
        "device": "LocalLoop",
        "message": "BARCODE ok=${flow.passGate} count=${flow.barcodeCount} text=${flow.barcodeText}",
        "topic": "",
        "variable": ""
      },
      {
        "name": "二维码 JSON",
        "device": "LocalLoop",
        "message": "{\"cmd\":\"BARCODE\",\"ok\":${flow.passGate},\"count\":${flow.barcodeCount},\"text\":\"${flow.barcodeText}\"}",
        "topic": "",
        "variable": ""
      }
    ],
    "heartbeat": {
      "enabled": false
    },
    "response": {},
    "messageTemplates": [
      {
        "id": "barcode-line",
        "name": "条码/二维码上报",
        "protocol": "line",
        "body": "BARCODE ok=${flow.passGate} count=${flow.barcodeCount} text=${flow.barcodeText}"
      },
      {
        "id": "qr-passgate",
        "name": "二维码门限行",
        "protocol": "line",
        "body": "QR ok=${flow.passGate} text=${flow.barcodeText}"
      }
    ],
    "tcpReal": {
      "host": "127.0.0.1",
      "port": 19956,
      "framing": "lf",
      "keepAlive": true,
      "reconnect": true,
      "role": "server",
      "ack": "OK",
      "payload": "BARCODE ok=${flow.passGate} text=${flow.barcodeText}"
    }
  },
  "runIntervalMs": 200
}
