  "steps": [
    {
      "id": "87b1fe5707f84f80",
      "operation": "preprocess",
      "name": "灰度预处理",
      "params": {
        "method": "grayscale",
        "threshold": 127,
        "kernel": 3,
        "cannyLow": 50,
        "cannyHigh": 150,
        "invert": false,
        "blur": 1
      },
      "position": {
        "x": 300,
        "y": 120
      },
      "imageFrom": "source"
    },
    {
      "id": "dbce45448b944262",
      "operation": "geometry",
      "name": "卡尺直线·铬",
      "params": {
        "feature": "lines",
        "findMethod": "caliper",
        "roiPreset": "center",
        "caliperCount": 12,
        "caliperWidth": 16,
        "caliperLength": 200,
        "caliperSigma": 1.0,
        "edgeType": "all",
        "edgePolarity": "any",
        "edgeThreshold": 25,
        "searchDir": "left_right",
        "maxCount": 3,
        "minScore": 0.35,
        "minLength": 40,
        "maximumResidual": 3.0,
        "showOverlay": true,
        "showPoints": true,
        "showCalipers": true,
        "showFitCurve": true,
        "showLabels": true,
        "showRuler": true,
        "judgeEnable": true,
        "judgeMin": 0.4,
        "judgeMax": 1.0
      },
      "position": {
        "x": 300,
        "y": 220
      },
      "imageFrom": "87b1fe5707f84f80"
    },
    {
      "id": "4073ecf7e80a4965",
      "operation": "point_distance",
      "name": "点距·公差判定",
      "params": {
        "mode": "manual",
        "unit": "px",
        "scale": 1.0,
        "x1": 60,
        "y1": 80,
        "x2": 160,
        "y2": 160,
        "showOverlay": true,
        "showPoints": true,
        "showLines": true,
        "showLabels": true,
        "showDistanceText": true,
        "showTolerance": true,
        "resultVar": "ptDist",
        "writeFlowVars": true,
        "judgeEnable": true,
        "judgeMin": 80.0,
        "judgeMax": 200.0
      },
      "position": {
        "x": 300,
        "y": 320
      },
      "imageFrom": "dbce45448b944262"
    },
    {
      "id": "16025c088cd24851",
      "operation": "ocr",
      "name": "OCR工业表",
      "params": {
        "lang": "eng",
        "minConfidence": 0.5,
        "showOverlay": true,
        "showBoxes": true,
        "showText": true,
        "judgeEnable": true,
        "expectedText": "BATCH",
        "judgeMinConfidence": 0.6,
        "resultVar": "ocrText",
        "writeFlowVars": true,
        "roi": [
          40,
          60,
          320,
          80
        ]
      },
      "position": {
        "x": 300,
        "y": 420
      },
      "imageFrom": "4073ecf7e80a4965"
    },
    {
      "id": "06c3f147e99442dc",
      "operation": "defects",
      "name": "缺陷工业表",
      "params": {
        "differenceThreshold": 25,
        "minArea": 20,
        "maxDefectRatio": 0.05,
        "showOverlay": true,
        "showBoxes": true,
        "showLabels": true,
        "judgeEnable": true,
        "judgeMaxCount": 2,
        "judgeMaxRatio": 0.05,
        "resultVar": "defectBag",
        "writeFlowVars": true,
        "method": "absdiff"
      },
      "position": {
        "x": 300,
        "y": 520
      },
      "imageFrom": "16025c088cd24851"
    },
    {
      "id": "14a1fd9a1754495d",
      "operation": "var_calc",
      "name": "铬摘要门限",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "distOk",
            "expression": "ptDist_judgeOk",
            "initial": false,
            "outType": "boolean"
          },
          {
            "name": "ocrOk",
            "expression": "ocrText_judgeOk",
            "initial": false,
            "outType": "boolean"
          },
          {
            "name": "defOk",
            "expression": "defectBag_judgeOk",
            "initial": false,
            "outType": "boolean"
          },
          {
            "name": "chromePass",
            "expression": "distOk and ocrOk and defOk",
            "initial": false,
            "outType": "boolean"
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 620
      },
