      "from": "0e8714b3da9f1de2",
      "to": "8a7fce98fe3d88ba",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ],
  "sourcePosition": {
    "x": 300,
    "y": 40
  },
  "variables": {
    "flow": {
      "fixture": 0,
      "fixture_x": 0,
      "fixture_y": 0,
