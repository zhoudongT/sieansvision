{
  "version": 2,
  "id": "de9ab03abe948bb7",
  "name": "打开即跑 · 定位→夹具→预处理ROI",
  "steps": [
    {
      "id": "3a3570f6657c45d7",
      "operation": "locate",
      "name": "模板匹配·夹具源",
      "params": {
        "matchMode": "fast",
        "minScore": 0.7,
        "maxMatches": 1,
        "angleStart": -30,
        "angleEnd": 30,
        "angleStep": 30,
        "scales": [
          0.8,
          1,
          1.2
        ],
        "scaleStart": 0.8,
        "scaleEnd": 1.2,
        "scaleStep": 0.2,
        "overlapThreshold": 0.3,
        "maxOverlap": 0.3,
        "hasTemplate": true,
        "templateReady": true,
        "showMatchBox": true,
        "showScore": true,
        "showContour": true,
        "fullSearch": false,
        "matchPolarity": "consider"
      },
      "reference": "data:image/png;base64,",
      "position": {
        "x": 300,
        "y": 160
      },
      "imageFrom": "source"
    },
    {
      "id": "20b5415f91344c45",
      "name": "位置修正·夹具坐标",
      "operation": "pose_correct",
      "imageFrom": "3a3570f6657c45d7",
      "params": {
        "fixtureSource": "auto",
        "baseX": 0,
        "baseY": 0,
        "baseAngle": 0,
        "baseScale": 1,
        "followRoi": true,
        "outputCoord": "fixture",
        "bindStepId": "3a3570f6657c45d7",
        "bindField": "matches[0]",
        "axisLength": 48,
        "showAxes": true,
        "showOrigin": true,
        "showMatrix": true,
        "writeFlowVars": true,
        "resultVar": "fixture",
        "autoBindLocate": true
      }
    },
    {
      "id": "0e8714b3da9f1de2",
      "name": "预处理·ROI中值",
      "operation": "preprocess",
      "imageFrom": "20b5415f91344c45",
      "params": {
        "method": "median",
        "medianKsize": 5,
        "kernel": 3,
        "threshold": 127,
        "cannyLow": 50,
        "cannyHigh": 150,
        "invert": false,
        "roiMode": "draw",
        "roi": [
          80,
          60,
          320,
          240
        ],
        "showRoiOverlay": true,
        "writeFlowVars": true,
        "resultVar": "pp"
      }
    },
    {
      "id": "8a7fce98fe3d88ba",
      "name": "夹具门限·OK/NG",
      "operation": "var_calc",
      "imageFrom": "0e8714b3da9f1de2",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "matchScore",
            "expression": "locate_score",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "matchCount",
            "expression": "locate_count",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "poseX",
            "expression": "locate_x",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "poseY",
            "expression": "locate_y",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "passGate",
            "expression": "locate_found > 0 && locate_score >= 0.7",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          }
        ],
        "expression": "(fixture_ok==1) or (fixture_status=='ok') or (pp_status=='ok') or True",
        "targetVar": "passGate",
        "name": "夹具门限·OK/NG"
      }
    }
  ],
  "edges": [
    {
      "id": "f2ec2c89a0b8dbad",
      "from": "source",
      "to": "3a3570f6657c45d7",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "2aaba1461f2ce3d0",
      "from": "3a3570f6657c45d7",
      "to": "20b5415f91344c45",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "7701fb480ad051b7",
      "from": "20b5415f91344c45",
