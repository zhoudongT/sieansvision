    ],
    "currentIndex": 0
  },
  "runUi": {
    "split": "4",
    "placements": [
      {
        "name": "图像",
        "page": 3,
        "cell": 0,
        "category": "基础"
      },
      {
        "name": "OK/NG",
        "page": 3,
        "cell": 1,
        "category": "基础"
      },
      {
        "name": "运行控制",
        "page": 3,
