{
  "version": 2,
  "id": "3be05ab1e4154f08",
  "name": "打开即跑 · 定位→测量→缺陷链",
  "steps": [
    {
      "id": "52337d482d174d9e",
      "operation": "locate",
      "name": "快速模板匹配",
      "params": {
        "matchMode": "fast",
        "minScore": 0.7,
        "maxMatches": 5,
        "angleStart": -30,
        "angleEnd": 30,
        "angleStep": 15,
        "scales": [
          0.8,
          1,
          1.2
        ],
        "scaleStart": 0.8,
        "scaleEnd": 1.2,
        "scaleStep": 0.2,
        "overlapThreshold": 0.3,
        "maxOverlap": 0.3,
        "hasTemplate": true,
        "templateReady": true,
        "showMatchBox": true,
        "showScore": true,
        "showContour": true,
        "fullSearch": false,
        "matchPolarity": "consider"
      },
      "reference": "data:image/png;base64,",
      "position": {
        "x": 300,
        "y": 140
      },
      "imageFrom": "source"
    },
    {
      "id": "90db367483a44bb8",
      "operation": "pose_correct",
      "name": "位置修正",
      "params": {
        "fixtureSource": "auto",
        "baseX": 0.0,
        "baseY": 0.0,
        "baseAngle": 0.0,
        "followRoi": true,
        "outputCoord": "fixture",
        "bindStepId": "52337d482d174d9e",
        "bindField": "items[0]"
      },
      "position": {
        "x": 300,
        "y": 260
      },
      "imageFrom": "52337d482d174d9e"
    },
    {
      "id": "dbf8ba189855447b",
      "operation": "measure",
      "name": "尺寸测量·圆",
      "params": {
        "feature": "circles",
        "threshold": 127,
        "minArea": 50,
        "unit": "px",
        "showOverlay": true,
        "showLabels": true
      },
      "position": {
        "x": 300,
        "y": 380
      },
      "imageFrom": "90db367483a44bb8"
    },
    {
      "id": "1056b990ce9d4b36",
      "operation": "defects",
      "name": "参考图差异缺陷",
      "params": {
        "differenceThreshold": 25,
        "minArea": 20,
        "maxDefectRatio": 0.5,
        "judgeEnable": true,
        "judgeMaxCount": 10,
        "judgeMaxRatio": 0.5,
        "showOverlay": true,
        "showBoxes": true,
        "showLabels": true,
        "resultVar": "defectBag",
        "writeFlowVars": true
      },
      "reference": "data:image/png;base64,",
      "position": {
        "x": 300,
        "y": 500
      },
      "imageFrom": "dbf8ba189855447b"
    },
    {
      "id": "6e6317a727144f71",
      "operation": "var_calc",
      "name": "综合门限·OK/NG",
      "params": {
        "scope": "flow",
        "expressions": [
          {
            "name": "matchScore",
            "expression": "locate_score",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "matchCount",
            "expression": "locate_count",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "poseX",
            "expression": "locate_x",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "poseY",
            "expression": "locate_y",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "measureCount",
            "expression": "measure_count",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "defectCount",
            "expression": "defects_count",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "defectRatio",
            "expression": "defects_ratio",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "defectOk",
            "expression": "defects_passed",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          },
          {
            "name": "passGate",
            "expression": "locate_found > 0 && locate_score >= 0.7 && measure_count > 0 && defects_passed > 0",
            "initial": 0,
            "outType": "number",
            "initOnRun": true
          }
        ]
      },
      "position": {
        "x": 300,
        "y": 620
      },
      "imageFrom": "1056b990ce9d4b36"
    }
  ],
  "edges": [
