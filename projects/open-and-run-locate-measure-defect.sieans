      "public/vision/samples/fixture-rotated.png"
    ],
    "currentIndex": 0
  },
  "globalTriggers": {
    "events": [],
    "strings": [
      {
        "match": "RUN",
        "partial": true,
        "commands": [
          {
            "type": "执行·单次"
          }
        ]
      },
      {
        "match": "CONT",
        "partial": true,
        "commands": [
          {
            "type": "执行·连续"
          }
        ]
      },
      {
        "match": "STOP",
        "partial": true,
        "commands": [
          {
            "type": "执行·停止"
          }
        ]
      }
    ]
  },
  "commManager": {
    "devices": [
      {
        "name": "LocalLoop",
        "protocol": "Local Bus",
        "host": "",
        "port": 0,
        "enabled": true,
        "remark": "进程内总线（打开即跑演示；无现场 TCP）"
      }
    ],
    "recvEvents": [
      {
        "name": "触发字串",
        "device": "LocalLoop",
        "message": "",
        "topic": "",
        "variable": "flow.commLastRecv"
      }
    ],
    "sendEvents": [
      {
        "name": "结果上报",
        "device": "LocalLoop",
        "message": "RESULT ok=${flow.passGate} score=${flow.matchScore} meas=${flow.measureCount} defect=${flow.defectCount}",
        "topic": "",
        "variable": ""
      },
      {
        "name": "JSON状态",
        "device": "LocalLoop",
        "message": "{\"cmd\":\"STATUS\",\"ok\":${flow.passGate},\"score\":${flow.matchScore},\"defects\":${flow.defectCount}}",
        "topic": "",
        "variable": ""
      }
    ],
    "heartbeat": {
      "enabled": true,
      "intervalMs": 5000,
      "payload": "HB"
    },
    "response": {
      "enabled": true,
      "timeoutMs": 3000,
      "ack": "OK"
    },
    "messageTemplates": [
      {
        "id": "result-line",
        "name": "OK/NG 行报文",
        "protocol": "TCP Client",
        "body": "RESULT ok=${flow.passGate} score=${flow.matchScore} meas=${flow.measureCount} defect=${flow.defectCount}"
      },
      {
        "id": "json-status",
        "name": "JSON 状态",
        "protocol": "TCP Client",
        "body": "{\"cmd\":\"STATUS\",\"ok\":${flow.passGate},\"score\":${flow.matchScore},\"defects\":${flow.defectCount}}"
      }
    ]
  },
  "runUi": {
    "split": "4",
