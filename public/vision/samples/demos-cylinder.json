[
  {
    "id": "cylinder-fit",
    "name": "3D 圆柱拟合 · 倾斜轴与离群点",
    "category": "3D",
    "cloud": "cylinder-outliers.json",
    "description": "600 个倾斜圆柱表面点和 40 个离群点，估计自由轴线与直径。采样轴向跨度用于判断覆盖，不代表实际工件长度。",
    "expected": "直径 20 mm；轴向约 (0.3,-0.4,0.866025)，独立内点 600/640；40 个离群点标红。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-cylinder",
          "pluginVersion": "1.0.0",
          "operatorId": "fit",
          "arguments": {
            "detailMode": "outside"
          },
          "outputBindings": [
            {
              "field": "cylinder",
              "name": "cylinderReference",
              "scope": "flow"
            },
            {
              "field": "diameter",
              "name": "cylinderDiameter",
              "scope": "flow"
            },
            {
              "field": "passed",
              "name": "cylinderFitOK",
              "scope": "flow"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "cylinder-inspect",
    "name": "3D 圆柱侧面 · 凸起与凹陷",
    "category": "3D",
    "cloud": "cylinder-defects.json",
    "description": "对照独立圆柱基准，在 ±0.1 mm 侧面公差内检出局部凸起和凹陷。",
    "expected": "最大径向偏差 +0.5 mm、最小 -0.3 mm；2 个超差点，判定不通过。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-cylinder",
          "pluginVersion": "1.0.0",
          "operatorId": "inspect",
          "arguments": {
            "cylinder": {
              "model": "sieans-cylinder-v1",
              "axisPoint": [
                12.0,
                -4.0,
                30.0
              ],
              "axisDirection": [
                0.3,
                -0.4,
                0.8660254037844386
              ],
              "radius": 10,
              "unit": "mm",
              "frame": "cylinder-fixture"
            },
            "detailMode": "outside"
          },
          "outputBindings": [
            {
              "field": "outsideCount",
              "name": "cylinderDefects",
              "scope": "flow"
            },
            {
              "field": "passed",
              "name": "cylinderOK",
              "scope": "flow"
            }
          ]
        }
      }
    ]
  },
