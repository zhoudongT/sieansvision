[
  {
    "id": "plugin-brightness",
    "name": "扩展插件 · 图像亮度检测",
    "category": "检测",
    "image": "parts.png",
    "description": "独立 Python 插件使用 OpenCV 统计全图灰度亮度，输入与输出由插件清单生成表单。",
    "expected": "像素数量 294000；亮度均值在 10–230 内；流程变量 brightnessOK 为是。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-inspection",
          "pluginVersion": "1.0.0",
          "operatorId": "brightness",
          "arguments": {
            "minimumMean": 10,
            "maximumMean": 230
          },
          "outputBindings": [
            {
              "field": "passed",
              "scope": "flow",
              "name": "brightnessOK"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "plugin-centroid",
    "name": "扩展插件 · 点云质心偏差",
    "category": "3D",
    "image": "parts.png",
    "cloud": "cloud-box.json",
    "description": "独立 Python 插件计算采样点质心并检查到目标的距离，按输入点云单位显示。",
    "expected": "箱体表面采样质心为 (10, 5, 2.5) mm；到目标偏差接近 0，判定通过。采样质心不是实体质量重心。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-inspection",
          "pluginVersion": "1.0.0",
          "operatorId": "centroid",
          "arguments": {
            "targetX": 10,
            "targetY": 5,
            "targetZ": 2.5,
            "tolerance": 0.01
          }
        }
      }
    ]
  },
  {
    "id": "color-regions",
    "name": "色彩区域 · 红色跨端点筛选",
    "category": "检测",
    "image": "color-regions.png",
    "description": "HSV 色相 170–10 跨越红色端点，排除绿色与蓝色。面积按像素计数，参数由插件生成表单。",
    "expected": "2 个红色区域，面积 12000 和 4800 px²，总面积 16800 px²；流程变量 redCount=2。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-regions",
          "pluginVersion": "1.0.0",
          "operatorId": "color",
          "arguments": {
            "hueMin": 170,
            "hueMax": 10,
            "minimumCount": 2,
            "maximumCount": 2,
            "outputImage": "annotated"
          },
          "outputBindings": [
            {
              "field": "count",
              "scope": "flow",
              "name": "redCount"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "color-to-blobs",
    "name": "色彩掩膜 → 斑点尺寸筛选",
    "category": "流程",
    "image": "color-regions.png",
    "description": "色彩算子输出筛选后的二值图，再按像素面积保留大红色目标；展示插件图像通道的串联。",
    "expected": "色彩筛选得到 2 个区域；斑点面积下限 6000 后剩 1 个，面积 12000 px²，质心 (109.5, 109.5)。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-regions",
          "pluginVersion": "1.0.0",
          "operatorId": "color",
          "arguments": {
            "outputImage": "mask"
          },
          "outputBindings": []
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-regions",
          "pluginVersion": "1.0.0",
          "operatorId": "blobs",
          "arguments": {
            "minimumArea": 6000,
            "minimumCount": 1,
            "maximumCount": 1,
            "outputImage": "annotated"
          },
          "outputBindings": []
        }
      }
    ]
  },
  {
    "id": "surface-deviations",
    "name": "3D 表面 · 凸起与凹陷偏差",
    "category": "3D",
    "image": "color-regions.png",
    "cloud": "cloud-deviations.json",
    "description": "以 z=10 mm 为基准面，检查 ±0.1 mm 公差带。超差点红色、合格点绿色；不代表最小区域平面度。",
    "expected": "121 点中 2 点超差；最大偏差 +0.5 mm、最小 -0.3 mm，判定未通过。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-surface",
          "pluginVersion": "1.0.0",
          "operatorId": "plane-distance",
          "arguments": {
            "planeOffset": -10,
            "lowerDistance": -0.1,
            "upperDistance": 0.1
          },
          "outputBindings": [
            {
              "field": "outsideCount",
              "scope": "flow",
              "name": "surfaceDefects"
            }
          ]
        }
      }
    ]
  },
