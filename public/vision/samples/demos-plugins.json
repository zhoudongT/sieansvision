  {
    "id": "normals-pass",
    "name": "3D 法向 → 30° 斜面合格",
    "category": "3D",
    "image": "parts.png",
    "cloud": "cloud-slope.json",
    "description": "合成倾斜平面；使用局部邻域拟合，结果按法向、坡度和拟合残差明细表显示。",
    "expected": "121 个有效点，坡度 30°；零超差，判定通过，绿色显示。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-normals",
          "pluginVersion": "1.0.0",
          "operatorId": "inspect",
          "arguments": {
            "maximumSlopeDegrees": 35
          },
          "outputBindings": [
            {
              "field": "passed",
              "scope": "flow",
              "name": "slopeOK"
            },
            {
              "field": "invalidCount",
              "scope": "flow",
              "name": "invalidNormals"
            }
          ]
        }
      }
    ]
  },
