[
  {
    "id": "sphere-fit",
    "name": "3D 球面拟合 · 离群点剔除",
    "category": "3D",
    "cloud": "sphere-outliers.json",
    "description": "600 个半径 10 mm 的球面点，另外加入 40 个外侧离群点；RANSAC 与几何优化恢复球心和直径。",
    "expected": "球心 (12,-4,30) mm，直径 20 mm；独立内点 600/640，拟合通过。红色为拟合离群点。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-sphere",
          "pluginVersion": "1.0.0",
          "operatorId": "fit",
          "arguments": {
            "detailMode": "outside"
          },
          "outputBindings": [
            {
              "field": "sphere",
              "name": "sphereReference",
              "scope": "flow"
            },
            {
              "field": "diameter",
              "name": "sphereDiameter",
              "scope": "flow"
            },
            {
              "field": "passed",
              "name": "sphereFitOK",
              "scope": "flow"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "sphere-inspect",
    "name": "3D 球面偏差 · 凸起与凹陷",
    "category": "3D",
    "cloud": "sphere-defects.json",
    "description": "与已知球面基准比较；在 ±0.1 mm 公差下找出 0.5 mm 凸起和 0.3 mm 凹陷。",
    "expected": "2 个超差点标红；最大偏差 +0.5 mm，最小偏差 -0.3 mm，检测不通过。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-sphere",
          "pluginVersion": "1.0.0",
          "operatorId": "inspect",
          "arguments": {
            "sphere": {
              "model": "sieans-sphere-v1",
              "center": [
                12.0,
                -4.0,
                30.0
              ],
              "radius": 10,
              "unit": "mm",
              "frame": "sphere-fixture"
            },
            "detailMode": "outside"
          },
          "outputBindings": [
            {
              "field": "outsideCount",
              "name": "sphereDefects",
              "scope": "flow"
            },
            {
              "field": "passed",
              "name": "sphereOK",
              "scope": "flow"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "sphere-chain",
    "name": "3D 球面拟合 → 偏差检测",
    "category": "3D",
    "cloud": "sphere-defects.json",
    "description": "先拟合主体球面并将模型写入流程变量，再由下一算子读取变量检查所有点。自拟合基准用于形状偏差，不用于绝对位置偏差。",
    "expected": "拟合通过、直径约 20 mm；后续仍检出 2 个局部超差点。模型以字段表展示和绑定。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-sphere",
          "pluginVersion": "1.0.0",
          "operatorId": "fit",
          "arguments": {
            "detailMode": "outside"
          },
          "outputBindings": [
            {
              "field": "sphere",
              "name": "sphereReference",
              "scope": "flow"
            },
            {
              "field": "diameter",
              "name": "sphereDiameter",
              "scope": "flow"
            },
            {
              "field": "passed",
              "name": "sphereFitOK",
              "scope": "flow"
            }
          ]
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-sphere",
          "pluginVersion": "1.0.0",
          "operatorId": "inspect",
          "arguments": {
            "sphere": {
              "$ref": "flow.sphereReference"
            },
            "detailMode": "outside"
          },
          "outputBindings": [
            {
              "field": "outsideCount",
              "name": "sphereDefects",
              "scope": "flow"
            },
            {
              "field": "passed",
              "name": "sphereOK",
              "scope": "flow"
            }
          ]
        }
      }
    ]
  },
