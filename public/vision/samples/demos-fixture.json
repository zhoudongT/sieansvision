[
  {
    "id": "fixture-multiple",
    "name": "多目标定位 · 旋转与缩放去重",
    "category": "定位",
    "image": "fixture-multiple.png",
    "description": "非对称模板在三种角度/比例下出现，按旋转四边形重叠去重；每个目标提供坐标和位姿表。",
    "expected": "检出 3 个独立目标：约 (110,100)、(320,110)、(230,270) px；角度 0°、30°、−30°。",
    "steps": [
      {
        "operation": "locate",
        "reference": "fixture-template.png",
        "params": {
          "minScore": 0.94,
          "angleStart": -30,
          "angleEnd": 30,
          "angleStep": 30,
          "scales": [
            0.8,
            1,
            1.2
          ],
          "maxMatches": 5,
          "overlapThreshold": 0.3
        }
      }
    ],
    "hmi": {
      "version": 1,
      "title": "多目标定位 · 旋转与缩放去重",
      "rows": 7,
      "rowHeight": 60,
      "components": [
        {
          "id": "fixture-image",
          "type": "image",
          "label": "本步处理图像",
          "x": 0,
          "y": 0,
          "w": 7,
          "h": 7,
          "color": "#1095bd",
          "fontSize": 20,
          "binding": {
            "source": "result",
            "nodeId": "demo-fixture",
            "path": ""
          }
        },
        {
          "id": "fixture-table",
          "type": "table",
          "label": "检测明细",
          "x": 7,
          "y": 0,
          "w": 5,
          "h": 7,
          "color": "#1095bd",
          "fontSize": 20,
          "binding": {
            "source": "result",
            "nodeId": "demo-fixture",
            "path": "items"
          }
        }
      ]
    },
    "hmiBindings": [
      {
        "component": 0,
        "step": 0
      },
      {
        "component": 1,
        "step": 0
      }
    ]
  },
  {
