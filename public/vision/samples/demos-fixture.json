  {
    "id": "fixture-inspect",
    "name": "定位跟随 · 校正后检测双孔",
    "category": "定位",
    "image": "fixture-rotated.png",
    "description": "模板定位 → 固定模板坐标的 56×40 检测区域校正 → 灰度斑点检测；目标移动、旋转和缩放后，下游仍在固定坐标检测。",
    "expected": "校正图为 56×40，检出 2 个暗区域；圆孔中心约 (14,18) px。",
    "steps": [
      {
        "operation": "locate",
        "reference": "fixture-template.png",
        "params": {
          "minScore": 0.94,
          "angleStart": -30,
          "angleEnd": 30,
          "angleStep": 30,
          "scales": [
            0.8,
            1,
            1.2
          ],
          "maxMatches": 5,
          "overlapThreshold": 0.3
        }
      },
      {
        "operation": "variables",
        "params": {
          "scope": "flow",
          "name": "partPose",
          "value": {}
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-fixture",
          "pluginVersion": "1.0.0",
          "operatorId": "rectify",
          "arguments": {
            "pose": {
              "$ref": "flow.partPose"
            },
            "cropX": 12,
            "cropY": 12,
            "cropWidth": 56,
            "cropHeight": 40
          },
          "outputBindings": []
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-regions",
          "pluginVersion": "1.0.0",
          "operatorId": "blobs",
          "arguments": {
            "polarity": "dark",
            "threshold": 100,
            "minimumArea": 30,
            "maximumArea": 500,
            "minimumCount": 2,
            "maximumCount": 2
          },
          "outputBindings": [
            {
              "field": "count",
              "scope": "flow",
              "name": "holeCount"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "step": 1,
        "param": "value",
        "source": 0,
        "field": "pose"
      }
    ],
    "hmi": {
      "version": 1,
      "title": "定位跟随 · 校正后检测双孔",
      "rows": 7,
      "rowHeight": 60,
      "components": [
        {
