    "connections": [
      [
        -1,
        0
      ],
      [
        0,
        1,
        "success"
      ],
      [
        0,
        2,
        "error"
      ],
      [
        1,
        3
      ],
      [
        2,
        3
      ],
      [
        3,
        4
      ]
    ],
    "expected": "正常分支与错误分支只激活一路；汇合后 finished=true。失败节点保留错误，后续正常分支跳过，错误信息保存到流程变量 route。"
