  {
    "id": "branches",
    "category": "流程",
    "name": "分支与汇合 · 无序连线",
    "description": "图像源分成预处理与圆检测两路，轮廓节点等待两路完成，选择预处理图像作为输入。",
    "image": "parts.png",
    "steps": [
      {
        "operation": "geometry",
        "params": {
          "feature": "contours",
          "minArea": 50
        }
      },
      {
        "operation": "preprocess",
        "params": {
          "method": "threshold",
          "threshold": 127
        }
      },
      {
        "operation": "geometry",
        "params": {
          "feature": "circles",
          "roi": [
            350,
            40,
            220,
            200
          ],
          "minRadius": 45,
          "maxRadius": 65,
          "minDistance": 80
        }
      }
    ],
    "expected": "节点 02、03 先执行，节点 01 汇合后返回 3 个轮廓；移动位置不改变执行关系。",
    "check": {
      "count": 3
    },
    "connections": [
      [
        -1,
        1
      ],
      [
        -1,
        2
      ],
      [
        1,
        0
      ],
      [
        2,
        0
      ]
    ],
    "imageParents": [
      1,
      -1,
      -1
    ]
  },
  {
    "id": "python-vars",
    "category": "流程",
    "name": "识别结果 → Python → 三级变量",
    "description": "轮廓检测后由 Python 判定数量，并保存全局、流程和模块变量。载入后勾选“运行可信脚本”再运行。",
    "image": "parts.png",
    "steps": [
      {
        "operation": "geometry",
        "params": {
          "feature": "contours",
          "minArea": 50
        }
      },
      {
        "operation": "script",
        "params": {
          "timeoutMs": 5000,
          "code": "def run(ctx):\n    detection = next(v for v in ctx[\"results\"].values() if \"count\" in v)\n    count = detection[\"count\"]\n    expected = ctx[\"params\"][\"expectedCount\"]\n    cycles = ctx[\"vars\"][\"global\"].get(\"demoCycles\", 0) + 1\n    calls = ctx[\"vars\"][\"module\"].get(\"calls\", 0) + 1\n    print(\"Detected\", count, \"objects\")\n    return dict(result=dict(count=count, passed=count == expected, cycles=cycles, calls=calls))\n",
          "arguments": {
            "expectedCount": 3
          },
          "outputBindings": [
            {
              "field": "count",
              "scope": "flow",
              "name": "lastCount"
            },
            {
              "field": "passed",
              "scope": "flow",
              "name": "passed"
            },
            {
              "field": "cycles",
              "scope": "global",
              "name": "demoCycles"
            },
            {
              "field": "calls",
              "scope": "module",
              "name": "calls"
            }
          ]
        }
      }
    ],
    "expected": "返回 count=3、passed=true；变量管理中可查看三级变量。",
    "check": {
      "count": 3,
      "passed": true
    }
  },
  {
    "id": "error-recovery",
    "category": "流程控制",
    "name": "算子失败 → 错误分支 → 汇合",
    "description": "用成功/失败连线选择后续步骤；错误信息可绑定变量，恢复后与正常分支汇合。",
    "image": "parts.png",
    "steps": [
      {
        "operation": "condition",
        "params": {
          "comparison": "gt",
          "left": "无效数值",
          "right": 1
        }
      },
      {
        "operation": "variables",
        "params": {
          "scope": "flow",
          "name": "route",
          "value": "正常"
        }
      },
      {
        "operation": "variables",
        "params": {
          "scope": "flow",
          "name": "route",
          "value": ""
        }
      },
      {
        "operation": "branch_merge",
        "params": {}
      },
      {
        "operation": "variables",
        "params": {
          "scope": "flow",
          "name": "finished",
          "value": true
        }
      }
    ],
    "bindings": [
      {
        "step": 2,
        "param": "value",
        "source": 0,
        "field": "error"
      }
