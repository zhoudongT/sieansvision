      },
      {
        "id": "quality",
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-image-quality",
          "pluginVersion": "1.0.0",
          "operatorId": "inspect",
          "arguments": {
            "minimumSharpness": 10
          },
          "outputBindings": [
            {
              "scope": "flow",
              "name": "captureOK",
              "field": "passed"
            }
          ]
        }
      },
      {
        "id": "qualityGate",
        "operation": "condition",
        "params": {
          "comparison": "eq",
          "left": {
            "$ref": "results.quality.passed"
          },
          "right": true
        }
      },
      {
        "id": "vertical",
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-caliper",
          "pluginVersion": "1.0.0",
          "operatorId": "edge-line",
          "arguments": {
            "centerX": 160,
            "centerY": 200,
            "scanAngle": 0,
            "searchLength": 80,
            "probeCount": 9,
            "probeSpacing": 8
          }
        }
      },
      {
        "id": "verticalGate",
        "operation": "condition",
        "params": {
          "comparison": "eq",
          "left": {
            "$ref": "results.vertical.found"
          },
          "right": true
        }
      },
      {
        "id": "horizontal",
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-caliper",
          "pluginVersion": "1.0.0",
          "operatorId": "edge-line",
          "arguments": {
            "centerX": 250,
            "centerY": 120,
            "scanAngle": 90,
            "searchLength": 80,
            "probeCount": 9,
            "probeSpacing": 8
