        "params": {
          "pluginId": "sieans-relations",
          "pluginVersion": "1.0.0",
          "operatorId": "lines-2d",
          "arguments": {
            "entities": [
              {
                "x1": {
                  "$ref": "results.vertical.line.start.0"
