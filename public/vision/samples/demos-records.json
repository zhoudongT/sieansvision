[
  {
    "id": "records-inspection",
    "name": "检测记录 · 连续累积与统计",
    "category": "流程控制",
    "image": "parts.png",
    "variables": {
      "sequence": 0,
      "detectedCount": 0,
      "currentRecord": {},
      "inspectionRecords": [],
      "recordCount": 0,
      "meanCount": 0
    },
    "description": "每轮真实 OpenCV 计数，按字段创建记录并追加到流程变量；最多保留三行，满表显式丢弃最早记录。",
    "expected": "每条 count=3；多次运行后行数最多 3，序号递增，统计平均值为 3。",
    "steps": [
      {
        "operation": "variables",
        "params": {
          "scope": "flow",
          "name": "sequence",
          "mode": "increment",
          "value": 1
        }
      },
      {
        "operation": "geometry",
        "params": {
          "feature": "contours",
          "threshold": 127,
          "minArea": 50
        }
      },
      {
        "operation": "variables",
        "params": {
          "scope": "flow",
          "name": "detectedCount",
          "value": 0
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-records",
          "pluginVersion": "1.0.0",
          "operatorId": "build",
          "arguments": {
            "fields": {
              "sequence": {
                "$ref": "flow.sequence"
              },
              "count": {
                "$ref": "flow.detectedCount"
              },
              "passed": true
            }
          },
          "outputBindings": [
            {
              "scope": "flow",
              "name": "currentRecord",
              "field": "record"
            }
          ]
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-records",
          "pluginVersion": "1.0.0",
          "operatorId": "append",
          "arguments": {
            "records": {
              "$ref": "flow.inspectionRecords"
            },
            "record": {
              "$ref": "flow.currentRecord"
            },
            "capacity": 3,
            "overflow": "drop-oldest",
            "keyField": "sequence"
          },
          "outputBindings": [
            {
              "scope": "flow",
              "name": "inspectionRecords",
              "field": "records"
            },
            {
              "scope": "flow",
              "name": "recordCount",
              "field": "count"
            }
          ]
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-records",
          "pluginVersion": "1.0.0",
          "operatorId": "summary",
          "arguments": {
            "records": {
              "$ref": "flow.inspectionRecords"
            },
            "field": "count"
          },
          "outputBindings": [
            {
              "scope": "flow",
              "name": "meanCount",
              "field": "summary.mean"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "step": 2,
        "param": "value",
        "source": 1,
        "field": "count"
      }
    ],
    "hmi": {
      "version": 1,
      "title": "SIEANS 检测记录采样",
      "rows": 8,
      "rowHeight": 60,
      "components": [
        {
          "id": "records-value-0",
          "type": "value",
          "label": "采样序号",
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 32,
          "precision": 0,
          "unit": "",
          "binding": {
            "source": "flow",
            "path": "sequence"
          }
        },
        {
          "id": "records-value-1",
          "type": "value",
          "label": "保留记录数",
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 32,
          "precision": 0,
          "unit": "",
          "binding": {
            "source": "flow",
            "path": "recordCount"
          }
        },
        {
          "id": "records-value-2",
          "type": "value",
          "label": "平均检测数量",
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 32,
          "precision": 0,
          "unit": "",
          "binding": {
            "source": "flow",
            "path": "meanCount"
          }
        },
        {
          "id": "records-history",
          "type": "table",
          "label": "检测记录表",
          "x": 0,
          "y": 2,
          "w": 7,
          "h": 6,
          "color": "#1095bd",
          "fontSize": 20,
          "binding": {
            "source": "flow",
            "path": "inspectionRecords"
          }
        },
        {
          "id": "records-image",
          "type": "image",
          "label": "本轮检测图像",
          "x": 7,
          "y": 2,
          "w": 5,
          "h": 6,
          "color": "#1095bd",
          "fontSize": 20,
          "binding": {
            "source": "result",
            "nodeId": "demo-geometry",
            "path": ""
          }
        }
      ]
    },
    "hmiBindings": [
      {
        "component": 4,
        "step": 1
      }
    ]
  },
  {
    "id": "records-query",
    "name": "记录查询 · 筛选排序与最大项",
    "category": "流程控制",
    "image": "parts.png",
    "description": "筛选宽度至少 6 的记录、按宽度降序、读取首行并统计。显式跳过缺宽度的记录。",
    "expected": "保留宽度 12、8、6；首行宽度 12，统计平均值 26/3。",
    "variables": {
      "filteredRecords": [],
      "sortedRecords": []
    },
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-records",
          "pluginVersion": "1.0.0",
          "operatorId": "filter",
          "arguments": {
            "records": [
              {
                "id": 1,
                "width": 3
              },
              {
                "id": 2,
                "width": 8
              },
              {
                "id": 3,
                "width": 12
              },
              {
                "id": 4
              },
              {
                "id": 5,
                "width": 6
              }
            ],
            "field": "width",
            "comparison": "gte",
            "operand": {
              "value": 6
            },
            "missing": "skip"
          },
          "outputBindings": [
            {
              "scope": "flow",
              "name": "filteredRecords",
              "field": "records"
            }
          ]
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-records",
          "pluginVersion": "1.0.0",
          "operatorId": "sort",
          "arguments": {
            "records": {
              "$ref": "flow.filteredRecords"
            },
            "field": "width",
            "direction": "descending"
          },
          "outputBindings": [
            {
              "scope": "flow",
              "name": "sortedRecords",
              "field": "records"
            }
          ]
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-records",
          "pluginVersion": "1.0.0",
          "operatorId": "select",
          "arguments": {
            "records": {
              "$ref": "flow.sortedRecords"
            },
            "index": 0
          },
          "outputBindings": []
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-records",
          "pluginVersion": "1.0.0",
          "operatorId": "summary",
          "arguments": {
            "records": {
              "$ref": "flow.sortedRecords"
            },
            "field": "width"
          },
          "outputBindings": []
        }
      }
    ]
  },
