  {
    "id": "rigid-modbus",
    "name": "3D 坐标 → Modbus 模拟寄存器",
    "category": "工业通信",
    "cloud": "rigid-source.json",
    "description": "标定后的点位 X 保存到流程变量，再以 float32 写入并读回本机 Modbus 模拟器，不连接现场 PLC。",
    "expected": "工装点 X=280 mm；保持寄存器 80–81 写入/读回 float32 值 280。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-rigid",
          "pluginVersion": "1.0.0",
          "operatorId": "calibrate",
          "arguments": {},
          "outputBindings": [
            {
              "scope": "flow",
              "name": "frameCalibration",
              "field": "calibration"
            }
          ]
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-rigid",
          "pluginVersion": "1.0.0",
          "operatorId": "points",
          "arguments": {
            "calibration": {
              "$ref": "flow.frameCalibration"
            }
          },
          "outputBindings": [
            {
              "scope": "flow",
              "name": "fixtureX",
              "field": "items.0.targetX"
            }
          ]
        }
      },
      {
        "operation": "modbus_write",
        "params": {
          "transport": "simulator",
          "area": "holding",
          "address": 80,
          "dataType": "float32",
          "value": {
            "$ref": "flow.fixtureX"
          },
          "timeoutMs": 1500
        }
      },
      {
        "operation": "modbus_read",
        "params": {
          "transport": "simulator",
          "area": "holding",
          "address": 80,
          "dataType": "float32",
          "count": 1,
          "timeoutMs": 1500
        }
      }
    ]
  }
]
