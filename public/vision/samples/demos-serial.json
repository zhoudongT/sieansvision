[
  {
    "id": "serial-text",
    "name": "串口扫码文本 · 回环模拟",
    "category": "通信",
    "image": "parts.png",
    "description": "使用 pySerial 软件回环，发送内容按表单或字段表设置，再将应答写入流程变量。不会访问真实串口。",
    "expected": "serialReply 为 SIEANS-SERIAL-00042。",
    "steps": [
      {
        "operation": "serial_exchange",
        "params": {
          "connection": "simulator",
          "mode": "exchange",
          "encoding": "text",
          "timeoutMs": 3000,
          "maxBytes": 65536,
          "txFraming": "crlf",
          "rxFraming": "crlf",
          "clearInput": false,
          "value": "SIEANS-SERIAL-00042",
          "responseEncoding": "text"
        }
      },
      {
        "operation": "variables",
        "params": {
          "scope": "flow",
          "name": "serialReply",
          "value": 0
        }
      }
    ],
    "bindings": [
      {
        "step": 1,
        "source": 0,
        "param": "value",
        "field": "value"
      }
    ]
  },
  {
