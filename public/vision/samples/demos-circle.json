  {
    "id": "circle-ring",
    "name": "双圆检测 · 正常圆环",
    "category": "测量",
    "image": "circle-ring.png",
    "description": "两次圆形卡尺分别提取内外边缘，再绑定圆模型计算中心偏移与理想圆壁厚。两圆需来自同一图像坐标系；不等同沿真实轮廓测壁厚。",
    "expected": "中心距离约 0.10 mm，理想圆壁厚约 3.93–4.13 mm，通过。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-circle",
          "pluginVersion": "1.0.0",
          "operatorId": "caliper",
          "arguments": {
            "expectedRadius": 80,
            "polarity": "rising",
            "unitsPerPixel": 0.1,
            "unit": "mm",
            "minimumDiameter": 15,
            "maximumDiameter": 18
          },
          "outputBindings": [
            {
              "field": "circle",
              "scope": "flow",
              "name": "innerCircle"
            }
          ]
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-circle",
          "pluginVersion": "1.0.0",
          "operatorId": "caliper",
          "arguments": {
            "expectedRadius": 120,
            "polarity": "falling",
            "unitsPerPixel": 0.1,
            "unit": "mm",
            "minimumDiameter": 23,
            "maximumDiameter": 25
          },
          "outputBindings": [
            {
              "field": "circle",
              "scope": "flow",
              "name": "outerCircle"
            }
          ]
        }
      },
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-circle",
          "pluginVersion": "1.0.0",
          "operatorId": "nested",
          "arguments": {
            "innerCircle": {
              "$ref": "flow.innerCircle"
            },
            "outerCircle": {
              "$ref": "flow.outerCircle"
            },
            "maximumCenterDistance": 0.2,
            "minimumWall": 3.8,
            "maximumWall": 4.3
          },
          "outputBindings": [
            {
              "field": "passed",
              "scope": "flow",
              "name": "ringOK"
            },
            {
              "field": "centerDistance",
              "scope": "flow",
              "name": "centerOffset"
            }
          ]
        }
      }
    ],
    "hmi": {
      "version": 1,
      "title": "双圆检测 · 正常圆环",
      "rows": 8,
      "rowHeight": 60,
      "components": [
        {
          "id": "circle-summary-0",
          "type": "value",
          "label": "中心距离",
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 32,
          "binding": {
            "source": "result",
            "nodeId": "demo-circle",
            "path": "centerDistance"
          },
          "precision": 3,
          "unit": "mm"
        },
        {
          "id": "circle-summary-1",
          "type": "lamp",
          "label": "检测通过",
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 32,
          "binding": {
            "source": "result",
            "nodeId": "demo-circle",
            "path": "passed"
          }
        },
        {
          "id": "circle-image",
          "type": "image",
          "label": "圆测量标记图",
          "x": 0,
          "y": 2,
          "w": 6,
          "h": 6,
          "color": "#1095bd",
          "fontSize": 20,
          "binding": {
            "source": "result",
            "nodeId": "demo-circle",
            "path": ""
          }
        },
        {
          "id": "circle-details",
          "type": "table",
          "label": "双圆尺寸表",
          "x": 6,
          "y": 2,
          "w": 6,
          "h": 6,
          "color": "#1095bd",
          "fontSize": 20,
          "binding": {
            "source": "result",
            "nodeId": "demo-circle",
            "path": "items"
          }
        }
      ]
    },
    "hmiBindings": [
      {
        "component": 0,
        "step": 2
      },
      {
        "component": 1,
        "step": 2
      },
      {
        "component": 2,
        "step": 2
      },
      {
        "component": 3,
        "step": 2
      }
    ]
  },
