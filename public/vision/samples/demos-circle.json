[
  {
    "id": "circle-hole",
    "name": "圆形卡尺 · 圆孔定位与直径",
    "category": "测量",
    "image": "circle-hole.png",
    "description": "72 组向外灰度扫描，亚像素梯度峰值与几何圆拟合。0.1 mm/px 为演示比例，真实尺寸需先标定。",
    "expected": "圆心约 (321.35,239.65) px，直径约 16.08 mm，判定通过。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-circle",
          "pluginVersion": "1.0.0",
          "operatorId": "caliper",
          "arguments": {
            "unitsPerPixel": 0.1,
            "unit": "mm",
            "minimumDiameter": 16,
            "maximumDiameter": 16.2
          },
          "outputBindings": [
            {
              "field": "passed",
              "scope": "flow",
              "name": "circleOK"
            },
            {
              "field": "detectedCount",
              "scope": "flow",
              "name": "circleEdges"
            }
          ]
        }
      }
    ],
    "hmi": {
      "version": 1,
      "title": "圆形卡尺 · 圆孔定位与直径",
      "rows": 8,
      "rowHeight": 60,
      "components": [
        {
          "id": "circle-summary-0",
          "type": "value",
          "label": "测量直径",
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 32,
          "binding": {
            "source": "result",
            "nodeId": "demo-circle",
            "path": "diameter"
          },
          "precision": 3,
          "unit": "mm"
        },
        {
          "id": "circle-summary-1",
          "type": "lamp",
          "label": "检测通过",
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 32,
          "binding": {
            "source": "result",
            "nodeId": "demo-circle",
            "path": "passed"
          }
        },
        {
          "id": "circle-image",
          "type": "image",
          "label": "圆测量标记图",
          "x": 0,
          "y": 2,
          "w": 6,
          "h": 6,
          "color": "#1095bd",
          "fontSize": 20,
          "binding": {
            "source": "result",
            "nodeId": "demo-circle",
            "path": ""
          }
        },
        {
          "id": "circle-details",
          "type": "table",
          "label": "逐卡尺检测明细",
          "x": 6,
          "y": 2,
          "w": 6,
          "h": 6,
          "color": "#1095bd",
          "fontSize": 20,
          "binding": {
            "source": "result",
            "nodeId": "demo-circle",
            "path": "items"
          }
        }
      ]
    },
    "hmiBindings": [
      {
        "component": 0,
        "step": 0
      },
      {
        "component": 1,
        "step": 0
      },
      {
        "component": 2,
        "step": 0
      },
      {
        "component": 3,
        "step": 0
      }
    ]
  },
