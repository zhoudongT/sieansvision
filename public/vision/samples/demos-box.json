[
  {
    "id": "box-rotated",
    "name": "旋转包围盒 · 完整长方体",
    "category": "3D",
    "cloud": "box-rotated.json",
    "description": "完整长方体合成表面，三轴旋转。包围盒尺寸仅描述输入点集，不代表遮挡面的实物尺寸或实体体积，不提供唯一定位姿态。",
    "expected": "旋转包围盒 20 / 10 / 5 mm，通过；原坐标轴尺寸更大。",
    "steps": [
      {
        "operation": "plugin",
        "params": {
          "pluginId": "sieans-box",
          "pluginVersion": "1.0.0",
          "operatorId": "measure",
          "arguments": {
            "minimumLong": 19.9,
            "minimumMiddle": 9.9,
            "minimumShort": 4.9,
            "maximumLong": 20.1,
            "maximumMiddle": 10.1,
            "maximumShort": 5.1,
            "minimumThickness": 0.001
          },
          "outputBindings": [
            {
              "field": "length",
              "scope": "flow",
              "name": "boxLength"
            },
            {
              "field": "passed",
              "scope": "flow",
              "name": "boxOK"
            }
          ]
        }
      }
    ],
    "hmi": {
      "version": 1,
      "title": "旋转包围盒测量",
      "rows": 8,
