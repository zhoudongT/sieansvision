[
  {
    "id": "hmi-inspection",
    "name": "组态运行画面 · 相机数量检测",
    "category": "流程",
    "camera": true,
    "description": "模拟相机采集并检测数量；切换运行模式查看组态画面。可在画面写入目标数量并再次运行。",
    "expected": "检测数量 3。目标数量为 3 时通过，写入 4 后再次运行则未通过；画面仅访问模拟设备。",
    "variables": {
      "expected": 3
    },
    "steps": [
      {
        "operation": "camera_capture",
        "params": {
          "driver": "simulator",
          "deviceId": "synthetic-parts"
        }
      },
      {
        "operation": "geometry",
        "params": {
          "feature": "contours",
          "minArea": 50
        }
      },
      {
        "operation": "condition",
        "params": {
          "comparison": "eq",
          "left": 0,
          "right": {
            "$ref": "flow.expected"
          }
        }
      }
    ],
    "bindings": [
      {
        "step": 2,
        "source": 1,
        "param": "left",
        "field": "count"
      }
    ],
    "hmi": {
      "version": 1,
      "title": "SIEANS · 零件检测工作站",
      "rows": 8,
      "rowHeight": 60,
      "components": [
        {
          "id": "title",
          "type": "text",
          "label": "SIEANS · 零件数量检测",
          "x": 0,
          "y": 0,
          "w": 8,
          "h": 1,
          "color": "#1095bd",
          "fontSize": 24
        },
        {
          "id": "run",
          "type": "button",
          "label": "运行检测",
          "x": 8,
          "y": 0,
          "w": 2,
          "h": 1,
          "color": "#1095bd",
          "fontSize": 24,
          "action": "run"
        },
        {
          "id": "stop",
          "type": "button",
          "label": "停止检测",
          "x": 10,
          "y": 0,
          "w": 2,
          "h": 1,
          "color": "#1095bd",
          "fontSize": 24,
          "action": "stop"
        },
        {
          "id": "image",
          "type": "image",
          "label": "检测图像",
          "x": 0,
          "y": 1,
          "w": 7,
          "h": 4,
          "color": "#1095bd",
          "fontSize": 24,
          "binding": {
            "source": "result",
            "path": "",
            "nodeId": "detect"
          }
        },
        {
          "id": "count",
          "type": "value",
          "label": "检测数量",
          "x": 7,
          "y": 1,
          "w": 5,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 24,
          "precision": 0,
          "unit": "个",
          "binding": {
            "source": "result",
            "path": "count",
            "nodeId": "detect"
          }
        },
        {
          "id": "lamp",
          "type": "lamp",
          "label": "数量判定",
          "x": 7,
          "y": 3,
          "w": 5,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 24,
          "binding": {
            "source": "result",
            "path": "passed",
            "nodeId": "check"
          }
        },
        {
          "id": "expected",
          "type": "input",
          "label": "目标数量",
          "x": 0,
          "y": 5,
          "w": 4,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 24,
          "binding": {
            "source": "flow",
            "path": "expected"
          },
          "dataType": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "id": "time",
          "type": "value",
          "label": "运行耗时",
          "x": 4,
          "y": 5,
          "w": 3,
          "h": 2,
          "color": "#1095bd",
          "fontSize": 24,
          "binding": {
            "source": "status",
            "path": "elapsedMs"
          },
          "precision": 0,
          "unit": "ms"
        },
        {
          "id": "items",
          "type": "table",
          "label": "检测结果明细",
          "x": 7,
          "y": 5,
          "w": 5,
          "h": 3,
          "color": "#1095bd",
          "fontSize": 24,
          "binding": {
            "source": "result",
            "path": "items",
            "nodeId": "detect"
          }
        }
      ]
    },
    "hmiBindings": [
      {
        "component": 3,
        "step": 1
      },
      {
        "component": 4,
        "step": 1
      },
      {
        "component": 5,
        "step": 2
      },
      {
        "component": 8,
        "step": 1
      }
    ]
  }
]