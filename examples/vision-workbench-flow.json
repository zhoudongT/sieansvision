    "templateScope": "local",
    "format": "<template><div style=\"padding:12px\"><label>选择图像 <input type=\"file\" accept=\"image/*\" @change=\"readImage\"></label><p>{{ error }}</p></div></template><script>export default { data(){return {error:\"\"}}, methods:{readImage(event){const file=event.target.files[0];if(!file)return;if(file.size>12000000){this.error=\"图像超过 12 MB\";return;}this.error=\"\";const r=new FileReader();r.onload=()=>this.send({image:r.result});r.readAsDataURL(file);}}}</script>",
